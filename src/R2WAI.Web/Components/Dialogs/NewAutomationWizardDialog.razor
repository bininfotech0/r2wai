@inject ISnackbar Snackbar
@inject AuthenticatedHttpClient Http

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">New Automation</MudText>
    </TitleContent>
    <DialogContent>
        <div style="min-width: 480px; max-width: 640px;">
            <WizardStepper Steps="@_stepLabels" CurrentStep="_step" />

            <div class="mt-4">
                @if (_step == 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Choose how this automation starts</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Pick the event that should kick off this automation.</MudText>
                    <MudGrid>
                        @foreach (var trigger in _triggers)
                        {
                            <MudItem xs="6">
                                <MudPaper Class="pa-3 cursor-pointer" Elevation="0"
                                          Style="@($"border: 2px solid {(trigger == _selectedTrigger ? "var(--mud-palette-primary)" : "var(--mud-palette-divider)")}; border-radius: 10px; height: 100%;")"
                                          @onclick="@(() => _selectedTrigger = trigger)"
                                          @onkeydown="@(e => { if (e.Key is "Enter" or " ") _selectedTrigger = trigger; })"
                                          tabindex="0" role="button" aria-label="@($"Trigger: {trigger}")">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@GetTriggerIcon(trigger)" Color="@(trigger == _selectedTrigger ? Color.Primary : Color.Default)" Size="Size.Small" />
                                        <MudText Typo="Typo.body2" Style="font-weight: 600;">@trigger</MudText>
                                    </div>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                }
                else if (_step == 1)
                {
                    <MudText Typo="Typo.subtitle2" Class="mb-1">What should happen?</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Select the actions to run, in order.</MudText>
                    @foreach (var action in _availableActions)
                    {
                        var isSelected = _selectedActions.Contains(action);
                        var order = _selectedActions.IndexOf(action);
                        <MudPaper Class="pa-2 mb-2 d-flex align-center justify-space-between" Elevation="0"
                                  Style="@($"border: 1px solid {(isSelected ? "var(--mud-palette-primary)" : "var(--mud-palette-divider)")}; border-radius: 8px;")">
                            <div class="d-flex align-center gap-2">
                                @if (isSelected)
                                {
                                    <MudAvatar Size="Size.Small" Color="Color.Primary" Style="width: 22px; height: 22px; font-size: 0.7rem;">@(order + 1)</MudAvatar>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.RadioButtonUnchecked" Size="Size.Small" Color="Color.Default" />
                                }
                                <div>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@action.Label</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@action.Type</MudText>
                                </div>
                            </div>
                            <MudIconButton Icon="@(isSelected ? Icons.Material.Filled.Close : Icons.Material.Filled.Add)"
                                           Size="Size.Small" Color="@(isSelected ? Color.Error : Color.Primary)"
                                           OnClick="@(() => ToggleAction(action))"
                                           aria-label="@(isSelected ? $"Remove {action.Label}" : $"Add {action.Label}")" />
                        </MudPaper>
                    }
                }
                else if (_step == 2)
                {
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Set conditions (optional)</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Add conditions to control when actions run.</MudText>
                    @for (var i = 0; i < _conditions.Count; i++)
                    {
                        var index = i;
                        <MudPaper Class="pa-2 mb-2" Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: 8px;">
                            <MudGrid>
                                <MudItem xs="5">
                                    <MudTextField @bind-Value="_conditions[index].Field" Label="Field" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="4">
                                    <MudSelect T="string" @bind-Value="_conditions[index].Operator" Label="Operator" Variant="Variant.Outlined" Margin="Margin.Dense">
                                        <MudSelectItem T="string" Value="@("Is equal to")">Is equal to</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("Is not equal to")">Is not equal to</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("Contains")">Contains</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("Greater than")">Greater than</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("Less than")">Less than</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="2">
                                    <MudTextField @bind-Value="_conditions[index].Value" Label="Value" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="1" Class="d-flex align-center">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => _conditions.RemoveAt(index))" aria-label="Remove condition" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@(() => _conditions.Add(new ConditionRow()))">
                        Add Condition
                    </MudButton>
                }
                else
                {
                    <MudText Typo="Typo.subtitle2" Class="mb-3">Review &amp; confirm</MudText>
                    <MudTextField @bind-Value="_name" Label="Automation Name" Required="true" Variant="Variant.Outlined" Class="mb-4" />

                    <div class="d-flex align-center gap-2 py-1">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                        <MudText Typo="Typo.body2">Trigger identified: <strong>@_selectedTrigger</strong></MudText>
                    </div>
                    <div class="d-flex align-center gap-2 py-1">
                        <MudIcon Icon="@(_selectedActions.Count > 0 ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Info)"
                                 Color="@(_selectedActions.Count > 0 ? Color.Success : Color.Warning)" Size="Size.Small" />
                        <MudText Typo="Typo.body2">@(_selectedActions.Count) action(s) identified</MudText>
                    </div>
                    <div class="d-flex align-center gap-2 py-1">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="@(_conditions.Count > 0 ? Color.Success : Color.Default)" Size="Size.Small" />
                        <MudText Typo="Typo.body2">@(_conditions.Count) condition(s) identified</MudText>
                    </div>

                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                        This automation is ready to be created. You can fine-tune it with the advanced builder afterward.
                    </MudAlert>
                }
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        @if (_step > 0)
        {
            <MudButton OnClick="@(() => _step--)">Back</MudButton>
        }
        @if (_step < 3)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanAdvance())" OnClick="@(() => _step++)">
                Next
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_creating || string.IsNullOrWhiteSpace(_name))" OnClick="Create">
                @(_creating ? "Creating..." : "Create")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly List<string> _stepLabels = new() { "Trigger", "Actions", "Conditions", "Review" };
    private int _step;
    private bool _creating;

    private readonly List<string> _triggers = new()
    {
        "Application Submitted", "Application Updated", "Payment Received",
        "Form Submitted", "Schedule", "Webhook"
    };
    private string? _selectedTrigger;

    private readonly List<ActionOption> _availableActions = new()
    {
        new("Verify Documents", "AI Generate"),
        new("Get Application Details", "API Call"),
        new("Assign Officer", "API Call"),
        new("Send Notification", "Notification"),
        new("Update Application Status", "API Call"),
        new("Create Task", "Action"),
    };
    private readonly List<ActionOption> _selectedActions = new();

    private readonly List<ConditionRow> _conditions = new();

    private string _name = string.Empty;

    private bool CanAdvance() => _step switch
    {
        0 => !string.IsNullOrEmpty(_selectedTrigger),
        1 => _selectedActions.Count > 0,
        _ => true
    };

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(_name) && !string.IsNullOrEmpty(_selectedTrigger))
            _name = $"{_selectedTrigger} Automation";
    }

    private void ToggleAction(ActionOption action)
    {
        if (_selectedActions.Contains(action))
            _selectedActions.Remove(action);
        else
            _selectedActions.Add(action);

        if (_selectedActions.Count == 1 && string.IsNullOrEmpty(_name) && !string.IsNullOrEmpty(_selectedTrigger))
            _name = $"{_selectedTrigger} Automation";
    }

    private static string GetTriggerIcon(string trigger) => trigger switch
    {
        "Application Submitted" => Icons.Material.Outlined.Send,
        "Application Updated" => Icons.Material.Outlined.Edit,
        "Payment Received" => Icons.Material.Outlined.Payments,
        "Form Submitted" => Icons.Material.Outlined.Assignment,
        "Schedule" => Icons.Material.Outlined.Schedule,
        "Webhook" => Icons.Material.Outlined.Webhook,
        _ => Icons.Material.Outlined.Bolt,
    };

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;

        _creating = true;
        try
        {
            var steps = new List<object>();
            var order = 0;

            foreach (var condition in _conditions.Where(c => !string.IsNullOrWhiteSpace(c.Field)))
            {
                steps.Add(new { Order = order++, Name = $"{condition.Field} {condition.Operator} {condition.Value}", Action = "Condition" });
            }

            foreach (var action in _selectedActions)
            {
                steps.Add(new { Order = order++, Name = action.Label, Action = action.Type });
            }

            var payload = new
            {
                Name = _name,
                Description = (string?)null,
                Type = "sequential",
                Trigger = _selectedTrigger,
                Steps = System.Text.Json.JsonSerializer.Serialize(steps)
            };

            var response = await Http.PostAsJsonAsync("/api/v1/workflows", payload);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Automation '{_name}' created", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(body) ? "Failed to create automation" : body, Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Failed to create automation: {ex.Message}", Severity.Error); }
        finally { _creating = false; }
    }

    private void Cancel() => MudDialog.Cancel();

    private record ActionOption(string Label, string Type);
    private class ConditionRow
    {
        public string Field { get; set; } = string.Empty;
        public string Operator { get; set; } = "Is equal to";
        public string Value { get; set; } = string.Empty;
    }
}
