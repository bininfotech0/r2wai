<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="@ActionColor" />
            <MudText Typo="Typo.h6">@Title</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1">
            Are you sure you want to @(ActionLabel.ToLowerInvariant()) <strong>@ItemName</strong>?
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
            @(Description ?? "This item will be permanently removed.")
        </MudText>
        @if (Irreversible)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" Variant="Variant.Outlined">
                This action cannot be undone.
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" aria-label="Cancel">Cancel</MudButton>
        <MudButton OnClick="Confirm" Variant="Variant.Filled" Color="@ActionColor"
                   StartIcon="@ActionIcon" aria-label="@($"Confirm {ActionLabel.ToLowerInvariant()}")">
            @ActionLabel
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string ItemName { get; set; } = "this item";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm Delete";
    [Parameter] public string ActionLabel { get; set; } = "Delete";
    [Parameter] public string ActionIcon { get; set; } = Icons.Material.Filled.Delete;
    [Parameter] public Color ActionColor { get; set; } = Color.Error;
    [Parameter] public bool Irreversible { get; set; } = true;

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}
