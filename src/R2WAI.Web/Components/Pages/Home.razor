    private async Task LoadDailyTrend()
    {
        _loadingTrend = true;
        StateHasChanged();
        try
        {
            var result = await Http.GetFromJsonAsync<DailyTrendResult>($"/api/v1/operations/daily-trend?days={_dailyTrendDays}");
            var points = result?.Days ?? new();
            _trendXLabels = points.Select(p => p.Date.ToString("MMM d")).ToList();
            _trendSeries = new List<LineChart.ChartSeries>
            {
                new() { Label = "Conversations", Color = "#7C3AED", Data = points.Select(p => (double)p.Conversations).ToList() },
                new() { Label = "Runs", Color = "#3B82F6", Data = points.Select(p => (double)p.Runs).ToList() },
            };
        }
        catch
        {
            Snackbar.Add("Could not load platform trend data.", Severity.Warning);
        }
        finally
        {
            _loadingTrend = false;
            StateHasChanged();
        }
    }

