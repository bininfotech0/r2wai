@page "/"
@attribute [Authorize]
@inject AuthenticatedHttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>R2WAI - AI Command Center</PageTitle>

<div class="d-flex justify-space-between align-start flex-wrap gap-3 greeting-section mb-4">
    <div>
        <MudText Typo="Typo.h4" Style="font-weight: 600;">Good @GetTimeOfDay(), @_userName 👋</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-1" Style="line-height: 1.5;">Here's what's happening with your R2WAI platform.</MudText>
    </div>
    <div class="d-flex align-center gap-2">
        <MudSelect T="int" Value="_dailyTrendDays" ValueChanged="OnDailyTrendDaysChanged" Variant="Variant.Outlined" Margin="Margin.Dense"
                   Style="min-width: 140px;" AdornmentIcon="@Icons.Material.Filled.CalendarMonth" Adornment="Adornment.Start">
            <MudSelectItem T="int" Value="7">Last 7 days</MudSelectItem>
            <MudSelectItem T="int" Value="14">Last 14 days</MudSelectItem>
            <MudSelectItem T="int" Value="30">Last 30 days</MudSelectItem>
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="btn-gradient"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Navigation.NavigateTo("/assistant-studio"))">
            New Assistant
        </MudButton>
    </div>
</div>

@* Getting Started — only for brand-new tenants *@
@if (_showGettingStarted)
{
    <GettingStarted OnDismiss="DismissGettingStarted" />
}

@* KPI Row *@
<MudGrid Class="mb-4" Spacing="3">
    <MudItem xs="12" sm="6" md="4" lg="2">
        <KpiCard Label="AI Assistants" Value="@_totalAssistants.ToString()" Icon="@Icons.Material.Outlined.SmartToy"
                 IconColor="Color.Primary" Delta="@DeltaFor(_assistantsTrendPercent)" Trend="@TrendFor(_assistantsTrendPercent)"
                 OnClick="@(() => Navigation.NavigateTo("/assistant-studio"))"
                 AriaLabel="@($"AI Assistants: {_totalAssistants}. View all assistants.")" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4" lg="2">
        <KpiCard Label="Automations" Value="@_totalWorkflows.ToString()" Icon="@Icons.Material.Outlined.AccountTree"
                 IconColor="Color.Secondary" Subtitle="@($"{_activeWorkflows} active")"
                 OnClick="@(() => Navigation.NavigateTo("/workflow-studio"))"
                 AriaLabel="@($"Automations: {_totalWorkflows}. View all automations.")" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4" lg="2">
        <KpiCard Label="Executions" Value="@_totalExecutions.ToString()" Icon="@Icons.Material.Outlined.PlaylistPlay"
                 IconColor="Color.Primary"
                 OnClick="@(() => Navigation.NavigateTo("/workflow-studio?tab=1"))"
                 AriaLabel="@($"Executions: {_totalExecutions}. View all runs.")" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4" lg="2">
        <KpiCard Label="Success Rate" Icon="@Icons.Material.Outlined.TrendingUp" IconColor="Color.Warning"
                 Value="@(_workflowSuccessRatePercent.HasValue ? $"{_workflowSuccessRatePercent.Value:F1}%" : "—")"
                 Subtitle="Last 30 days" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4" lg="2">
        <KpiCard Label="Active Users" Value="@_activeUsersByLogin.ToString()" Icon="@Icons.Material.Outlined.Groups"
                 IconColor="Color.Primary" Delta="@DeltaFor(_activeUsersTrendPercent)" Trend="@TrendFor(_activeUsersTrendPercent)"
                 OnClick="@(() => Navigation.NavigateTo("/admin/users"))"
                 AriaLabel="@($"Active Users: {_activeUsersByLogin}. View all users.")" />
    </MudItem>
</MudGrid>

@* Platform Overview + Application Status *@
<MudGrid Class="mb-4" Spacing="3">
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4" Elevation="0" Style="border: 1px solid var(--mud-palette-divider); height: 100%;">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 700;">Platform Overview</MudText>
            @if (_loadingTrend)
            {
                <LoadingSkeleton Variant="LoadingSkeleton.SkeletonVariant.Detail" />
            }
            else
            {
                <LineChart Series="_trendSeries" XAxisLabels="_trendXLabels" Height="220" />
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4" Elevation="0" Style="border: 1px solid var(--mud-palette-divider); height: 100%;">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 700;">Automations by Status</MudText>
            @if (_totalWorkflows == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.AccountTree" Title="No automations yet"
                            Description="Create your first automation to see its status here." MinHeight="180px" />
            }
            else
            {
                <div class="d-flex justify-center">
                    <DonutChart Segments="_workflowStatusSegments" Size="160" CenterLabel="Total" CenterValue="@_totalWorkflows.ToString()" />
                </div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@* AI Command Bar *@
<div class="ai-command-bar mb-4">
    <div class="d-flex align-center gap-2 mb-3">
        <div class="icon-container icon-container--primary" style="width: 28px; height: 28px; border-radius: 8px;">
            <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Color="Color.Primary" Style="font-size: 0.9rem;" />
        </div>
        <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">What would you like to do?</MudText>
    </div>
    <MudTextField @bind-Value="_commandInput" Placeholder="Create an HR assistant, build an approval automation, search knowledge..."
                  Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Send" AdornmentAriaLabel="Submit command"
                  AdornmentColor="Color.Primary" OnAdornmentClick="HandleCommand"
                  OnKeyUp="HandleCommandKeyUp" Immediate="true"
                  Style="border-radius: 10px;" aria-label="AI Command input" />

    @* Knowledge Base Search Results *@
    @if (_searching)
    {
        <MudPaper Elevation="2" Class="pa-4 mt-3" Style="border-radius: var(--r2-radius-md);">
            <div class="d-flex align-center gap-2 mb-3">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Searching knowledge bases...</MudText>
            </div>
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Class="mb-2" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Class="mb-2" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" />
        </MudPaper>
    }
    else if (_searchResults.Count > 0)
    {
        <MudPaper Elevation="2" Class="pa-4 mt-3" Style="border-radius: var(--r2-radius-md); max-height: 400px; overflow-y: auto;">
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">
                    <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" Style="vertical-align: middle;" />
                    Search Results
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="ClearSearchResults" aria-label="Clear search results" />
            </div>
            @foreach (var group in _searchResults.GroupBy(r => r.KnowledgeBaseName))
            {
                <div class="mb-3">
                    <div class="d-flex align-center gap-2 mb-2">
                        <MudIcon Icon="@Icons.Material.Outlined.MenuBook" Size="Size.Small" Color="Color.Primary" />
                        <MudText Typo="Typo.caption" Style="font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;" Color="Color.Primary">
                            @group.Key
                        </MudText>
                    </div>
                    @foreach (var result in group)
                    {
                        <MudPaper Elevation="0" Class="pa-3 mb-2 search-result-item" Style="border: 1px solid var(--mud-palette-divider); border-radius: var(--r2-radius-sm); cursor: pointer;"
                                  @onclick="@(() => Navigation.NavigateTo("/assistant-studio/knowledge"))" @onkeydown="@(e => NavigateOnEnter(e, "/assistant-studio/knowledge"))"
                                  tabindex="0" role="button" aria-label="@($"Search result from {group.Key}. Open Knowledge Bases.")">
                            <MudText Typo="Typo.body2" Style="line-height: 1.5;">@((MarkupString)HighlightSearchTerm(result.Content, _lastSearchQuery))</MudText>
                            @if (!string.IsNullOrEmpty(result.SourceName))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                    <MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Small" Style="font-size: 12px; vertical-align: middle;" />
                                    @result.SourceName
                                    <span style="margin-left: 8px; opacity: 0.6;">Score: @result.Score.ToString("P0")</span>
                                </MudText>
                            }
                        </MudPaper>
                    }
                </div>
            }
        </MudPaper>
    }

    <div class="d-flex gap-2 mt-3 flex-wrap">
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" Class="quick-action-chip"
                   OnClick="@(() => Navigation.NavigateTo("/assistant-studio"))">
            New Assistant
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Add" Class="quick-action-chip"
                   OnClick="@(() => Navigation.NavigateTo("/workflow-studio"))">
            New Automation
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Tertiary"
                   StartIcon="@Icons.Material.Filled.CloudUpload" Class="quick-action-chip"
                   OnClick="@(() => Navigation.NavigateTo("/documents"))">
            Upload Docs
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Extension" Class="quick-action-chip"
                   OnClick="@(() => Navigation.NavigateTo("/workflow-studio/integrations"))">
            Integrations
        </MudButton>
    </div>
</div>

@* AI Insights *@
@if (_insights.Count > 0)
{
    <MudText Typo="Typo.h6" Class="mb-3 section-title">AI Insights</MudText>
    <div class="d-flex flex-column gap-3 mb-4 stagger-in">
        @foreach (var insight in _insights)
        {
            <AiInsightCard Title="@insight.Title" Description="@insight.Description"
                           PrimaryActionText="@insight.ActionText"
                           PrimaryAction="@(() => HandleInsightAction(insight))"
                           SecondaryAction="@(() => DismissInsight(insight))" />
        }
    </div>
}

@* Recent Automations + Right Rail *@
<MudGrid Spacing="3">
    <MudItem xs="12" md="8">
        <div class="d-flex justify-space-between align-center mb-3">
            <MudText Typo="Typo.h6" Class="section-title">Recent Automations</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Navigation.NavigateTo("/workflow-studio"))">
                View all
            </MudButton>
        </div>
        <MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-divider); overflow: hidden;">
            @if (_loading)
            {
                <div class="pa-4">
                    <LoadingSkeleton Variant="LoadingSkeleton.SkeletonVariant.Table" />
                </div>
            }
            else if (_recentWorkflows.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.AccountTree"
                            Title="No automations yet"
                            Description="Create your first automation to put a business process on autopilot."
                            ActionText="New Automation" OnAction="@(() => Navigation.NavigateTo("/workflow-studio"))" />
            }
            else
            {
                <div style="overflow-x: auto;">
                <MudTable T="WorkflowSummary" Items="_recentWorkflows" Hover="true" Dense="true" Elevation="0" RowsPerPage="5">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Trigger</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Last updated</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">
                            <MudLink Href="@($"/workflow-studio/automations/{context.Id}")" Underline="Underline.None" Style="font-weight: 600;">@context.Name</MudLink>
                        </MudTd>
                        <MudTd DataLabel="Trigger">@(context.Trigger ?? "—")</MudTd>
                        <MudTd DataLabel="Status"><StatusBadge Status="@context.VersionStatus" /></MudTd>
                        <MudTd DataLabel="Last updated">@((context.ModifiedAt ?? context.CreatedAt).ToString("MMM d, yyyy"))</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager RowsPerPageString="" InfoFormat="{first_item}-{last_item} of {all_items}" />
                    </PagerContent>
                </MudTable>
                </div>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudText Typo="Typo.h6" Class="mb-3 section-title">Quick Actions</MudText>
        <MudPaper Elevation="0" Class="pa-3 mb-4" Style="border: 1px solid var(--mud-palette-divider);">
            <div class="d-flex flex-wrap gap-2">
                @foreach (var action in _quickActions)
                {
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default" Class="quick-action-chip"
                               StartIcon="@action.Icon" OnClick="@(() => Navigation.NavigateTo(action.Url))"
                               Style="text-transform: none; flex: 1 1 calc(50% - 8px); justify-content: flex-start;">
                        @action.Label
                    </MudButton>
                }
            </div>
        </MudPaper>

        @if (_loading)
        {
            <MudText Typo="Typo.h6" Class="mb-3 section-title">Recent Activity</MudText>
            <MudPaper Elevation="0" Class="pa-4 mb-4" Style="border: 1px solid var(--mud-palette-divider);">
                <LoadingSkeleton Variant="LoadingSkeleton.SkeletonVariant.Timeline" />
            </MudPaper>
        }
        else
        {
            <div class="mb-4">
                <LiveActivityFeed Title="Recent Activity" MaxHeight="320px" Items="@BuildActivityFeedItems()" />
            </div>
        }

        <MudText Typo="Typo.h6" Class="mb-3 section-title">System Health</MudText>
        <MudPaper Elevation="0" Class="pa-4 mb-4" Style="border: 1px solid var(--mud-palette-divider);">
            @if (_healthChecks.Count > 0 || !_loading)
            {
                <div class="d-flex align-center gap-2 mb-2">
                    <MudIcon Icon="@(_healthStatus == "Healthy" ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)"
                             Color="@(_healthStatus == "Healthy" ? Color.Success : Color.Warning)" />
                    <MudText Typo="Typo.body1" Style="font-weight: 700;">
                        @(_healthStatus == "Healthy" ? "All systems operational" : _healthStatus)
                    </MudText>
                </div>
                @if (_healthChecks.Count > 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">All components are running smoothly.</MudText>
                    <div class="stagger-in">
                        @foreach (var check in _healthChecks)
                        {
                            <div class="d-flex justify-space-between align-center py-1">
                                <MudText Typo="Typo.caption" Style="font-weight: 500;">@check.Name</MudText>
                                <div class="d-flex align-center gap-2">
                                    <span class="health-dot health-dot--@(check.Status == "Healthy" ? "healthy" : check.Status == "Degraded" ? "degraded" : "unhealthy")"></span>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@check.Status</MudText>
                                </div>
                            </div>
                        }
                    </div>
                }
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2"
                           OnClick="@(() => Navigation.NavigateTo("/operations"))">
                    View status
                </MudButton>
            }
            else
            {
                <div class="d-flex align-center gap-2 justify-center pa-2">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Loading health data...</MudText>
                </div>
            }
        </MudPaper>

        @if (_integrations.Count > 0)
        {
            <MudText Typo="Typo.h6" Class="mb-3 section-title">Integration Status</MudText>
            <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid var(--mud-palette-divider);">
                <div class="stagger-in">
                    @foreach (var integration in _integrations)
                    {
                        <div class="d-flex justify-space-between align-center py-1">
                            <MudText Typo="Typo.caption" Style="font-weight: 500;">@integration.Name</MudText>
                            <div class="d-flex align-center gap-2">
                                <span class="health-dot health-dot--@(integration.IsActive ? "healthy" : "unhealthy")"></span>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@(integration.IsActive ? "Connected" : "Disconnected")</MudText>
                            </div>
                        </div>
                    }
                </div>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mt-2"
                           OnClick="@(() => Navigation.NavigateTo("/workflow-studio/integrations"))">
                    View all
                </MudButton>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    private string _commandInput = string.Empty;
    private string _userName = "there";
    private bool _loading = true;
    private bool _loadingTrend = true;
    private int _pendingApprovals;
    private int _activeWorkflows;
    private int _completedToday;
    private string _healthStatus = "Healthy";
    private int _totalAssistants;
    private int _totalWorkflows;
    private int _totalDocuments;
    private int _totalKnowledgeBases;
    private int _totalConversations;
    private int _totalExecutions;
    private int _activeUsersByLogin;
    private double? _workflowSuccessRatePercent;
    private double? _assistantsTrendPercent;
    private double? _conversationsTrendPercent;
    private double? _activeUsersTrendPercent;
    private List<WorkflowSummary> _recentWorkflows = new();
    private List<ActivityItem> _activities = new();
    private List<HealthEntry> _healthChecks = new();
    private List<IntegrationStatusItem> _integrations = new();
    private List<InsightItem> _insights = new();
    private bool _showGettingStarted;
    private List<KbSearchResultItem> _searchResults = new();
    private bool _searching;
    private string _lastSearchQuery = string.Empty;
    private List<KnowledgeBaseListDto> _knowledgeBases = new();
    private int _dailyTrendDays = 7;
    private List<LineChart.ChartSeries> _trendSeries = new();
    private List<string> _trendXLabels = new();
    private List<DonutChart.ChartSegment> _workflowStatusSegments = new();

    private readonly List<QuickAction> _quickActions = new()
    {
        new("Create Assistant", Icons.Material.Filled.SmartToy, "/assistant-studio"),
        new("Add Knowledge", Icons.Material.Filled.MenuBook, "/assistant-studio/knowledge"),
        new("Add Tool / API", Icons.Material.Filled.Build, "/assistant-studio/tools"),
        new("Create Automation", Icons.Material.Filled.AccountTree, "/workflow-studio"),
        new("Test Assistant", Icons.Material.Filled.PlayArrow, "/assistant-studio/playground"),
    };

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            if (AuthState is not null)
            {
                var state = await AuthState;
                var email = state.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
                var firstName = state.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;
                _userName = firstName ?? email?.Split('@')[0] ?? "there";
            }
        }
        catch { }

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));

            var metricsTask = Http.GetFromJsonAsync<MetricsDto>("/api/v1/operations/metrics");
            var logsTask = Http.GetFromJsonAsync<LogsResult>("/api/v1/operations/audit-logs?pageSize=10");
            var healthTask = LoadHealth();
            var integrationsTask = LoadIntegrations();
            var approvalsTask = LoadApprovals();
            var kbTask = Http.GetFromJsonAsync<KbListResult>("/api/v1/knowledgebases");
            var workflowsTask = Http.GetFromJsonAsync<WorkflowsResult>("/api/v1/workflows?page=1&pageSize=5");
            var executionsTask = Http.GetFromJsonAsync<InstancesCountResult>("/api/v1/operations/workflow-instances?pageSize=1");

            var allTasks = Task.WhenAll(metricsTask, logsTask, healthTask, integrationsTask, approvalsTask, kbTask, workflowsTask, executionsTask);
            var completed = await Task.WhenAny(allTasks, Task.Delay(Timeout.Infinite, cts.Token));
            if (completed != allTasks)
            {
                Snackbar.Add("Dashboard data is taking longer than expected.", Severity.Warning);
            }
            try { await allTasks; } catch { }

            var metrics = metricsTask.Result;
            if (metrics is not null)
            {
                _totalAssistants = metrics.TotalAssistants;
                _totalWorkflows = metrics.TotalWorkflows;
                _activeWorkflows = metrics.ActiveWorkflows;
                _totalDocuments = metrics.TotalDocuments;
                _totalKnowledgeBases = metrics.TotalKnowledgeBases;
                _totalConversations = metrics.TotalConversations;
                _completedToday = metrics.CompletedToday;
                _activeUsersByLogin = metrics.ActiveUsersByLogin;
                _workflowSuccessRatePercent = metrics.WorkflowSuccessRatePercent;
                _assistantsTrendPercent = metrics.AssistantsTrendPercent;
                _conversationsTrendPercent = metrics.ConversationsTrendPercent;
                _activeUsersTrendPercent = metrics.ActiveUsersTrendPercent;
                if (metrics.PendingApprovals > 0) _pendingApprovals = metrics.PendingApprovals;
            }

            _totalExecutions = executionsTask.Result?.TotalCount ?? 0;

            _knowledgeBases = kbTask.Result?.Items ?? new();

            _recentWorkflows = (workflowsTask.Result?.Items ?? new())
                .OrderByDescending(w => w.ModifiedAt ?? w.CreatedAt)
                .ToList();
            BuildWorkflowStatusSegments();

            _activities = (logsTask.Result?.Items ?? new())
                .Select(l => new ActivityItem
                {
                    Action = l.Action,
                    EntityType = l.EntityType,
                    Description = $"{l.Action} {l.EntityType}" + (!string.IsNullOrEmpty(l.EntityId) ? $" #{l.EntityId[..Math.Min(8, l.EntityId.Length)]}" : ""),
                    Timestamp = l.Timestamp
                })
                .ToList();

            GenerateInsights();

            _showGettingStarted = _totalAssistants == 0 && _totalWorkflows == 0 && _totalDocuments == 0;
        }
        catch
        {
            Snackbar.Add("Could not load dashboard data.", Severity.Warning);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }

        await LoadDailyTrend();
    }

    private void BuildWorkflowStatusSegments()
    {
        // Only Active/Inactive is available from the already-loaded metrics counts (no per-workflow
        // status breakdown is fetched on this page) — an honest coarse split rather than fabricating
        // finer buckets the data doesn't support.
        var inactive = Math.Max(0, _totalWorkflows - _activeWorkflows);
        _workflowStatusSegments = new List<DonutChart.ChartSegment>
        {
            new() { Label = "Active", Value = _activeWorkflows, Color = "var(--mud-palette-success)" },
            new() { Label = "Inactive", Value = inactive, Color = "var(--mud-palette-text-secondary)" },
        };
    }

    private async Task OnDailyTrendDaysChanged(int days)
    {
        _dailyTrendDays = days;
        await LoadDailyTrend();
    }

    private async Task LoadDailyTrend()
    {
        _loadingTrend = true;
        StateHasChanged();
        try
        {
            var result = await Http.GetFromJsonAsync<DailyTrendResult>($"/api/v1/operations/daily-trend?days={_dailyTrendDays}");
            var points = result?.Days ?? new();
            _trendXLabels = points.Select(p => p.Date.ToString("MMM d")).ToList();
            _trendSeries = new List<LineChart.ChartSeries>
            {
                new() { Label = "Conversations", Color = "#7C3AED", Data = points.Select(p => (double)p.Conversations).ToList() },
                new() { Label = "Runs", Color = "#3B82F6", Data = points.Select(p => (double)p.Runs).ToList() },
            };
        }
        catch
        {
            Snackbar.Add("Could not load platform trend data.", Severity.Warning);
        }
        finally
        {
            _loadingTrend = false;
            StateHasChanged();
        }
    }

    private void DismissGettingStarted() => _showGettingStarted = false;

    private async Task LoadApprovals()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<ApprovalsResult>("/api/v1/approvals/pending");
            _pendingApprovals = result?.Items?.Count ?? 0;
        }
        catch (Exception)
        {
            Snackbar.Add("Could not load approvals.", Severity.Warning);
        }
    }

    private async Task LoadHealth()
    {
        try
        {
            var response = await Http.GetAsync("/health");
            if (response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                var doc = System.Text.Json.JsonDocument.Parse(body);
                var root = doc.RootElement;
                _healthStatus = root.GetProperty("status").GetString() ?? "Unknown";

                if (root.TryGetProperty("checks", out var checks))
                {
                    foreach (var check in checks.EnumerateArray())
                    {
                        _healthChecks.Add(new HealthEntry
                        {
                            Name = check.GetProperty("name").GetString() ?? "—",
                            Status = check.GetProperty("status").GetString() ?? "Unknown"
                        });
                    }
                }
            }
            else { _healthStatus = "Unhealthy"; }
        }
        catch { _healthStatus = "Unreachable"; }
    }

    private async Task LoadIntegrations()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<IntegrationsResult>("/api/v1/integrations");
            _integrations = (result?.Items ?? new())
                .Select(i => new IntegrationStatusItem { Name = i.Name, IsActive = i.IsActive })
                .Take(5)
                .ToList();
        }
        catch { }
    }

