@page "/governance"
@attribute [Authorize(Roles = "Admin,SystemAdmin")]
@inject AuthenticatedHttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>R2WAI - Governance</PageTitle>

<PageHeader Title="Governance" Subtitle="Platform-wide oversight across departments, applications and AI usage." />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}

<MudGrid Class="mb-5" Spacing="3">
    <MudItem xs="6" sm="4" md="2">
        <KpiCard Value="@_totalDepartments.ToString()" Label="Departments" Icon="@Icons.Material.Outlined.AccountBalance"
                 ValueColor="Color.Primary" IconColor="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/governance/departments"))" />
    </MudItem>
    <MudItem xs="6" sm="4" md="2">
        <KpiCard Value="@_totalApplications.ToString()" Label="Applications" Icon="@Icons.Material.Outlined.Apps"
                 ValueColor="Color.Secondary" IconColor="Color.Secondary" OnClick="@(() => Navigation.NavigateTo("/applications"))" />
    </MudItem>
    <MudItem xs="6" sm="4" md="2">
        <KpiCard Value="@_totalAssistants.ToString()" Label="Assistants" Icon="@Icons.Material.Outlined.SmartToy"
                 ValueColor="Color.Tertiary" IconColor="Color.Tertiary" OnClick="@(() => Navigation.NavigateTo("/assistant-studio"))" />
    </MudItem>
    <MudItem xs="6" sm="4" md="2">
        <KpiCard Value="@_totalUsers.ToString()" Label="Users" Icon="@Icons.Material.Outlined.PeopleAlt"
                 ValueColor="Color.Info" IconColor="Color.Info" OnClick="@(() => Navigation.NavigateTo("/admin/users"))" />
    </MudItem>
    <MudItem xs="12" sm="8" md="4">
        <KpiCard Value="@_aiRequests24h.ToString()" Label="AI Requests (24h)" Icon="@Icons.Material.Outlined.AutoAwesome"
                 ValueColor="Color.Warning" IconColor="Color.Warning" OnClick="@(() => Navigation.NavigateTo("/operations/ai"))" />
    </MudItem>
</MudGrid>

<div class="d-flex justify-space-between align-center mb-3">
    <div>
        <MudText Typo="Typo.h6" Style="font-weight: 700;">Global Policies</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Tenant-wide governance policies that apply across every department and application.</MudText>
    </div>
</div>

<MudGrid Spacing="3">
    @foreach (var type in _policyTypes)
    {
        var policy = _policies.FirstOrDefault(p => p.Type == type.Key);
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid var(--mud-palette-divider); border-radius: 12px; height: 100%;">
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@type.Value</MudText>
                    <StatusBadge Status="@((policy?.IsActive ?? false) ? "Active" : policy is null ? "Not configured" : "Inactive")" />
                </div>
                @if (policy is not null && !string.IsNullOrWhiteSpace(policy.Content))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3" Style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                        @policy.Content
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">No policy text defined yet.</MudText>
                }
                <MudButton Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" OnClick="@(() => OpenEditPolicy(type.Key, type.Value, policy))">
                    @(policy is null ? "Configure" : "Edit")
                </MudButton>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@if (_editingType is not null)
{
    <MudDialog @bind-Visible="_showEditDialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
        <DialogContent>
            <MudText Typo="Typo.h6" Class="mb-3">@_editName</MudText>
            <MudTextField @bind-Value="_editName" Label="Policy Name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
            <MudTextField @bind-Value="_editContent" Label="Policy Text" Variant="Variant.Outlined" Lines="8" Class="mb-3"
                          Placeholder="Describe the rule this policy enforces or documents..." />
            <MudSwitch T="bool" @bind-Value="_editIsActive" Color="Color.Primary" Label="Active" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _showEditDialog = false)">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="SavePolicy">
                @(_saving ? "Saving..." : "Save")
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private int _totalDepartments;
    private int _totalApplications;
    private int _totalAssistants;
    private int _totalUsers;
    private int _aiRequests24h;
    private List<PolicyItem> _policies = new();

    private bool _showEditDialog;
    private string? _editingType;
    private string _editName = string.Empty;
    private string _editContent = string.Empty;
    private bool _editIsActive;

    private readonly List<KeyValuePair<string, string>> _policyTypes = new()
    {
        new("AiUsage", "AI Usage Policy"),
        new("DataRetention", "Data Retention"),
        new("Pii", "PII Policy"),
        new("ToolExecution", "Tool Execution Policy"),
        new("Approval", "Approval Policy"),
        new("Knowledge", "Knowledge Policy"),
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _loading = true;
        try
        {
            await Task.WhenAll(LoadCounts(), LoadPolicies());
        }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task LoadCounts()
    {
        try
        {
            var departments = await Http.GetFromJsonAsync<CountResult>("/api/v1/departments?page=1&pageSize=1");
            _totalDepartments = departments?.TotalCount ?? 0;

            var applications = await Http.GetFromJsonAsync<CountResult>("/api/v1/applications?page=1&pageSize=1");
            _totalApplications = applications?.TotalCount ?? 0;

            var users = await Http.GetFromJsonAsync<CountResult>("/api/v1/admin/users?page=1&pageSize=1");
            _totalUsers = users?.TotalCount ?? 0;

            var metrics = await Http.GetFromJsonAsync<MetricsResult>("/api/v1/operations/metrics");
            _totalAssistants = metrics?.TotalAssistants ?? 0;
            _aiRequests24h = metrics?.AiRequests ?? 0;
        }
        catch (Exception ex) { Snackbar.Add($"Failed to load governance stats: {ex.Message}", Severity.Error); }
    }

    private async Task LoadPolicies()
    {
        try
        {
            _policies = await Http.GetFromJsonAsync<List<PolicyItem>>("/api/v1/governance/policies") ?? new();
        }
        catch (Exception ex) { Snackbar.Add($"Failed to load policies: {ex.Message}", Severity.Error); }
    }

    private void OpenEditPolicy(string type, string defaultName, PolicyItem? existing)
    {
        _editingType = type;
        _editName = existing?.Name ?? defaultName;
        _editContent = existing?.Content ?? string.Empty;
        _editIsActive = existing?.IsActive ?? false;
        _showEditDialog = true;
    }

    private async Task SavePolicy()
    {
        if (_editingType is null) return;
        _saving = true;
        try
        {
            var payload = new { Name = _editName, Content = _editContent, IsActive = _editIsActive };
            var response = await Http.PutAsJsonAsync($"/api/v1/governance/policies/{_editingType}", payload);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(body) ? "Failed to save policy" : body, Severity.Error);
                return;
            }
            _showEditDialog = false;
            await LoadPolicies();
            Snackbar.Add("Policy saved", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Failed to save policy: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }

    private class CountResult { public int TotalCount { get; set; } }
    private class MetricsResult { public int TotalAssistants { get; set; } public int AiRequests { get; set; } }
    private class PolicyItem
    {
        public Guid Id { get; set; }
        public string Type { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Content { get; set; }
        public bool IsActive { get; set; }
    }
}
