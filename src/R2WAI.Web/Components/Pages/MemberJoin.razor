@page "/member-join"
@attribute [AllowAnonymous]
@layout R2WAI.Web.Components.Layout.AuthLayout
@inject HttpClient HttpClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject JwtAuthenticationStateProvider AuthStateProvider

<PageTitle>R2WAI - Join</PageTitle>

<div class="login-container">
    <div class="auth-content">
        <AuthShowcase />

        <MudPaper Class="pa-6 pa-sm-10 login-card" Elevation="0">
        <div class="d-flex flex-column align-center mb-6">
            <div class="mb-4">
                <Brand Size="48" ShowWordmark="false" />
            </div>
            <MudText Typo="Typo.h4" Align="Align.Center" Style="font-weight: 700; letter-spacing: -0.02em;">Join R2WAI</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mt-1" Style="max-width: 320px; line-height: 1.5;">
                Create your member account with your Aadhaar number. You're signed in right away — no waiting for approval.
            </MudText>
        </div>

        <EditForm Model="_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="_model.FullName"
                          Label="Full Name"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.PersonOutline"
                          Class="mb-3"
                          Required="true"
                          RequiredError="Full name is required."
                          AutoFocus="true"
                          aria-label="Full name" />

            <MudTextField @bind-Value="_model.AadhaarNumber"
                          Label="Aadhaar Number"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Badge"
                          Class="mb-1"
                          MaxLength="12"
                          InputMode="InputMode.numeric"
                          Placeholder="12-digit Aadhaar number"
                          Required="true"
                          RequiredError="Aadhaar number is required."
                          aria-label="Aadhaar number" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                We record your Aadhaar number for identity purposes; it is not verified against any government registry.
            </MudText>

            <MudTextField @bind-Value="_model.MobileNumber"
                          Label="Mobile Number"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.PhoneAndroid"
                          Class="mb-3"
                          MaxLength="10"
                          InputMode="InputMode.tel"
                          Placeholder="10-digit mobile number"
                          Required="true"
                          RequiredError="Mobile number is required."
                          aria-label="Mobile number" />

            <MudTextField @bind-Value="_model.Email"
                          Label="Email address (optional)"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.MailOutline"
                          Class="mb-3"
                          aria-label="Email address (optional)" />

            <MudTextField @bind-Value="_model.Password"
                          Label="Password"
                          Variant="Variant.Outlined"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          AdornmentAriaLabel="@(_showPassword ? "Hide password" : "Show password")"
                          OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                          Class="mb-1"
                          Required="true"
                          RequiredError="Password is required."
                          aria-label="Password" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4 d-block">
                At least 10 characters, with upper and lower case, a digit, and a special character.
            </MudText>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="_isLoading"
                       Class="btn-gradient"
                       Style="height: 48px; border-radius: 12px; font-weight: 600;"
                       aria-label="Create account">
                @if (_isLoading)
                {
                    <MudProgressCircular Class="ms-n1 me-2" Size="Size.Small" Indeterminate="true"
                                         Color="Color.Surface" />
                    <span>Creating account...</span>
                }
                else
                {
                    <span>Create Account</span>
                }
            </MudButton>
        </EditForm>

        <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary" Class="mt-6">
            Already have an account?&nbsp;
            <MudLink Href="/login" Color="Color.Primary" Style="font-weight: 600;">Sign in</MudLink>
        </MudText>
        </MudPaper>
    </div>
</div>

@code {
    private MemberJoinModel _model = new();
    private bool _isLoading;
    private bool _showPassword;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private async Task HandleSubmit()
    {
        _isLoading = true;
        try
        {
            var response = await HttpClient.PostAsJsonAsync("/api/v1/auth/register-member", new
            {
                _model.FullName,
                _model.AadhaarNumber,
                _model.MobileNumber,
                _model.Password,
                Email = string.IsNullOrWhiteSpace(_model.Email) ? null : _model.Email,
            });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<RegisterMemberResponse>();
                if (result is not null)
                {
                    var userJson = System.Text.Json.JsonSerializer.Serialize(result.User);
                    await AuthStateProvider.LoginAsync(result.Token, result.RefreshToken, userJson);
                    Snackbar.Add("Welcome to R2WAI!", Severity.Success);
                    Navigation.NavigateTo(ReturnUrl ?? "/");
                }
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                var message = TryExtractErrorMessage(body) ?? "Could not create your account. Please check your details and try again.";
                Snackbar.Add(message, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to connect to server: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string? TryExtractErrorMessage(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("detail", out var detail))
                return detail.GetString();
            if (doc.RootElement.TryGetProperty("errors", out var errors))
            {
                foreach (var prop in errors.EnumerateObject())
                {
                    if (prop.Value.ValueKind == System.Text.Json.JsonValueKind.Array && prop.Value.GetArrayLength() > 0)
                        return prop.Value[0].GetString();
                }
            }
        }
        catch { }
        return null;
    }

    public class MemberJoinModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Full name is required.")]
        public string FullName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Aadhaar number is required.")]
        public string AadhaarNumber { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Mobile number is required.")]
        public string MobileNumber { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Please enter a valid email address.")]
        public string? Email { get; set; }
    }

    private class RegisterMemberResponse
    {
        public string Token { get; set; } = string.Empty;
        public string RefreshToken { get; set; } = string.Empty;
        public DateTime ExpiresAt { get; set; }
        public MemberUserInfo User { get; set; } = new();
    }

    private class MemberUserInfo
    {
        public Guid Id { get; set; }
        public string? Email { get; set; }
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string? AvatarUrl { get; set; }
        public string Role { get; set; } = string.Empty;
        public string[] Roles { get; set; } = [];
        public Guid TenantId { get; set; }
        public bool IsActive { get; set; }
    }
}
