@page "/"
@namespace R2WAI.Web.Components.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="R2WAI — Enterprise AI Work Platform. Build AI assistants, automate workflows, and execute enterprise work with AI." />
    <meta name="theme-color" content="#2563EB" />
    <meta property="og:title" content="R2WAI - Enterprise AI Work Platform" />
    <meta property="og:description" content="Build AI assistants, automate workflows, and execute enterprise work with AI." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="R2WAI - Enterprise AI Work Platform" />
    <title>R2WAI</title>
    <base href="~/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="css/app.css" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="manifest" href="manifest.json" />
    <style>
        .r2-splash {
            position: fixed;
            inset: 0;
            z-index: 99999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #F8FAFC 0%, #EFF6FF 100%);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }
        .r2-splash-logo {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            background: #2563EB;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 24px rgba(37, 99, 235, 0.25);
            animation: r2-logo-pulse 2s ease-in-out infinite;
            position: relative;
        }
        .r2-splash-logo svg {
            width: 28px;
            height: 28px;
            fill: white;
        }
        .r2-splash-title {
            margin-top: 24px;
            font-size: 1.375rem;
            font-weight: 700;
            color: #0F172A;
        }
        .r2-splash-subtitle {
            margin-top: 8px;
            font-size: 0.8125rem;
            color: #64748B;
            letter-spacing: 0.02em;
        }
        .r2-splash-dots {
            display: flex;
            gap: 6px;
            margin-top: 32px;
        }
        .r2-splash-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #2563EB;
            animation: r2-dot-bounce 1.4s ease-in-out infinite;
        }
        .r2-splash-dot:nth-child(2) { animation-delay: 0.2s; }
        .r2-splash-dot:nth-child(3) { animation-delay: 0.4s; }
        @@keyframes r2-logo-pulse {
            0%, 100% { box-shadow: 0 8px 24px rgba(37, 99, 235, 0.25), 0 0 0 0 rgba(37, 99, 235, 0.2); }
            50% { box-shadow: 0 8px 24px rgba(37, 99, 235, 0.3), 0 0 0 10px rgba(37, 99, 235, 0); }
        }
        @@keyframes r2-dot-bounce {
            0%, 80%, 100% { transform: scale(0.6); opacity: 0.3; }
            40% { transform: scale(1.2); opacity: 1; }
        }
        #blazor-error-ui {
            display: none;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 100000;
            padding: 16px 24px;
            background: #0F172A;
            color: white;
            font-family: 'Inter', sans-serif;
            font-size: 0.875rem;
            text-align: center;
            border-top: 2px solid #2563EB;
        }
        #blazor-error-ui a { color: #60A5FA; font-weight: 600; }
    </style>
</head>
<body>
    <div class="r2-splash" id="r2-splash">
        <div class="r2-splash-logo">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L14.09 8.26L20 9.27L15.55 13.97L16.91 20L12 16.9L7.09 20L8.45 13.97L4 9.27L9.91 8.26L12 2Z"/>
            </svg>
        </div>
        <div class="r2-splash-title">R2WAI</div>
        <div class="r2-splash-subtitle">AI Work Platform</div>
        <div class="r2-splash-dots">
            <span class="r2-splash-dot"></span>
            <span class="r2-splash-dot"></span>
            <span class="r2-splash-dot"></span>
        </div>
    </div>

    <component type="typeof(R2WAI.Web.Components.App)" render-mode="Server" />

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss" style="margin-left: 16px; cursor: pointer;">Dismiss</a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@@azure/msal-browser@@4.8.0/lib/msal-browser.min.js" crossorigin="anonymous"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_framework/blazor.server.js" autostart="false"></script>
    <script>
        window.r2waiHardRedirect = function (url) {
            window.location.href = url;
        };
        function hideSplash() {
            var splash = document.getElementById('r2-splash');
            if (splash && !splash.dataset.hidden) {
                splash.dataset.hidden = '1';
                splash.style.transition = 'opacity 0.5s ease';
                splash.style.opacity = '0';
                setTimeout(function () { splash.remove(); }, 500);
            }
        }
        Blazor.start().then(hideSplash);
        setTimeout(hideSplash, 10000);
        document.querySelector('#blazor-error-ui .dismiss')?.addEventListener('click', function () {
            document.getElementById('blazor-error-ui').style.display = 'none';
        });
    </script>
</body>
</html>
