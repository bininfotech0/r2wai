@page "/applications"
@attribute [Authorize]
@inject AuthenticatedHttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>R2WAI - Applications</PageTitle>

<PageHeader Title="Applications" Subtitle="Connect government applications and build an AI layer on top of them.">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="btn-gradient"
               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Navigation.NavigateTo("/applications/new"))">
        Add Application
    </MudButton>
</PageHeader>

@if (!_loading && _applications.Count > 0)
{
    <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: 12px;">
        <MudGrid>
            <MudItem xs="12" sm="5">
                <MudTextField @bind-Value="_searchTerm" Placeholder="Search applications..."
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" DebounceInterval="300" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="Guid?" @bind-Value="_departmentFilter" Label="Department" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    @foreach (var dept in _departments)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)dept.Id)">@dept.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3" Class="d-flex align-center gap-2 justify-end flex-wrap">
                @foreach (var status in new[] { "All", "Draft", "Configuring", "Published", "Disabled" })
                {
                    <MudChip T="string" Size="Size.Small"
                             Color="@(_statusFilter == status ? Color.Primary : Color.Default)"
                             Variant="@(_statusFilter == status ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => _statusFilter = status)">
                        @status
                    </MudChip>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
}
else if (_applications.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Outlined.Apps"
                Title="No applications yet"
                Description="Connect your first government application, register its APIs, and publish an assistant on top of it."
                ActionText="Add Application"
                OnAction="@(() => Navigation.NavigateTo("/applications/new"))"
                MinHeight="320px" />
}
else if (!_filteredApplications.Any())
{
    <EmptyState Icon="@Icons.Material.Outlined.SearchOff"
                Title="No applications match your filters"
                Description="Try a different search term, department or status."
                ActionText="Clear filters"
                OnAction="@(() => { _searchTerm = string.Empty; _departmentFilter = null; _statusFilter = "All"; })"
                MinHeight="240px" />
}
else
{
    <MudGrid Spacing="3" Class="stagger-in">
        @foreach (var app in _filteredApplications)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid var(--mud-palette-divider); border-radius: 12px; height: 100%;">
                    <div class="d-flex justify-space-between align-center mb-3">
                        <div class="d-flex align-center gap-2">
                            <div class="icon-container icon-container--primary">
                                <MudIcon Icon="@Icons.Material.Outlined.Apps" Color="Color.Primary" Size="Size.Small" />
                            </div>
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">@app.Name</MudText>
                        </div>
                        <StatusBadge Status="@app.Status" />
                    </div>
                    @if (!string.IsNullOrEmpty(app.Description))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@app.Description</MudText>
                    }
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Department</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight: 500;">@GetDepartmentName(app.DepartmentId)</MudText>
                    </div>
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Environment</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight: 500;">@app.Environment</MudText>
                    </div>
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Created</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight: 500;">@app.CreatedAt.ToString("yyyy-MM-dd")</MudText>
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<ApplicationListItem> _applications = new();
    private List<DepartmentOption> _departments = new();
    private string _searchTerm = string.Empty;
    private Guid? _departmentFilter;
    private string _statusFilter = "All";
    private bool _loading = true;

    private IEnumerable<ApplicationListItem> _filteredApplications
    {
        get
        {
            var list = _applications.AsEnumerable();
            if (_statusFilter != "All")
                list = list.Where(a => a.Status.Equals(_statusFilter, StringComparison.OrdinalIgnoreCase));
            if (_departmentFilter is not null)
                list = list.Where(a => a.DepartmentId == _departmentFilter);
            if (!string.IsNullOrWhiteSpace(_searchTerm))
                list = list.Where(a => a.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
            return list;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDepartments();
            await LoadApplications();
        }
    }

    private async Task LoadDepartments()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<DepartmentsResult>("/api/v1/departments?page=1&pageSize=100");
            _departments = result?.Items ?? new();
        }
        catch { /* department names are a display nicety; the page still works without them */ }
    }

    private async Task LoadApplications()
    {
        _loading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<ApplicationsResult>("/api/v1/applications?page=1&pageSize=50");
            _applications = result?.Items ?? new();
        }
        catch (Exception ex) { Snackbar.Add($"Failed to load applications: {ex.Message}", Severity.Error); }
        finally { _loading = false; StateHasChanged(); }
    }

    private string GetDepartmentName(Guid departmentId) =>
        _departments.FirstOrDefault(d => d.Id == departmentId)?.Name ?? "—";

    private class ApplicationsResult { public List<ApplicationListItem> Items { get; set; } = new(); public int TotalCount { get; set; } }
    private class ApplicationListItem
    {
        public Guid Id { get; set; }
        public Guid DepartmentId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string Environment { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
    }
    private class DepartmentsResult { public List<DepartmentOption> Items { get; set; } = new(); }
    private class DepartmentOption { public Guid Id { get; set; } public string Name { get; set; } = string.Empty; }
}
