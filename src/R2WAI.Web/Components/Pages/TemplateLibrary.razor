@page "/templates"
@attribute [Authorize]
@inject AuthenticatedHttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>R2WAI - Template Library</PageTitle>

<PageHeader Title="Template Library" Subtitle="Pre-built workflows and assistants to get started quickly" />

@* Search & Filters *@
<MudPaper Class="pa-4 mb-4" Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: var(--r2-radius-md);">
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="_searchTerm" Placeholder="Search templates..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        </MudItem>
        <MudItem xs="12" sm="6" Class="d-flex align-center justify-end">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @FilteredItems.Count template(s) found
            </MudText>
        </MudItem>
    </MudGrid>
</MudPaper>

@* Tab Bar *@
<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" @bind-ActivePanelIndex="_activeTab"
         Style="border: 1px solid var(--mud-palette-divider); border-radius: var(--r2-radius-md);">

    @* ──────────────── Workflow Templates ──────────────── *@
    <MudTabPanel Text="Workflows" Icon="@Icons.Material.Outlined.AccountTree"
                 BadgeData="@_workflowTemplates.Count" BadgeColor="Color.Primary">
        <div class="pa-4">
            <div class="d-flex align-center gap-3 flex-wrap mb-3">
                <MudSelect T="string" Value="_workflowGroupFilter" ValueChanged="@((string g) => SetWorkflowGroup(g))"
                           Label="Browse by area" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                           Style="min-width: 260px;">
                    <MudSelectItem Value="@AllGroupsLabel">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Apps" Size="Size.Small" Style="color: #6B7280;" />
                            <span>All Categories</span>
                        </div>
                    </MudSelectItem>
                    @foreach (var g in _workflowGroups)
                    {
                        <MudSelectItem Value="@g.Group">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@_groupIcons.GetValueOrDefault(g.Group, Icons.Material.Filled.Category)" Size="Size.Small" Style="@($"color: {_groupColors.GetValueOrDefault(g.Group, "#6B7280")};")" />
                                <span>@g.Group</span>
                            </div>
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @(CurrentWorkflowChipCategories.Length - 1) categor@(CurrentWorkflowChipCategories.Length - 1 == 1 ? "y" : "ies")
                    @(_workflowCategoryFilter != "All" ? $"· filtering by \"{_workflowCategoryFilter}\"" : "")
                </MudText>
                @if (_workflowCategoryFilter != "All" || _workflowGroupFilter != "Core & Industry" || !string.IsNullOrWhiteSpace(_searchTerm))
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FilterAltOff"
                               OnClick="@ClearWorkflowFilters">
                        Clear filters
                    </MudButton>
                }
            </div>

            <div class="d-flex gap-2 flex-wrap mb-4"
                 style="@(_workflowGroupFilter == AllGroupsLabel ? "max-height: 130px; overflow-y: auto; padding-right: 4px;" : "")">
                @foreach (var cat in CurrentWorkflowChipCategories)
                {
                    <MudChip T="string" Size="Size.Small"
                             Color="@(_workflowCategoryFilter == cat ? Color.Primary : Color.Default)"
                             Variant="@(_workflowCategoryFilter == cat ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => _workflowCategoryFilter = cat)">
                        @cat
                    </MudChip>
                }
            </div>

            <MudGrid Spacing="3" Class="stagger-in">
                @foreach (var tmpl in FilteredWorkflowTemplates)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper Elevation="0" Style="@($"border: 1px solid var(--mud-palette-divider); border-left: 4px solid {GetWorkflowCategoryColor(tmpl.Category)}; border-radius: var(--r2-radius-md); height: 100%; display: flex; flex-direction: column;")">
                            <div class="pa-4" style="flex: 1; display: flex; flex-direction: column;">
                                <div class="d-flex align-center gap-3 mb-2">
                                    <MudIcon Icon="@GetWorkflowCategoryIcon(tmpl.Category)"
                                             Style="@($"color: {GetWorkflowCategoryColor(tmpl.Category)};")" />
                                    <div style="flex: 1; min-width: 0;">
                                        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@tmpl.Name</MudText>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 Style="@($"color: {GetWorkflowCategoryColor(tmpl.Category)}; border-color: {GetWorkflowCategoryColor(tmpl.Category)}; font-size: 0.6875rem; height: 20px;")">
                                            @tmpl.Category
                                        </MudChip>
                                    </div>
                                </div>

                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3"
                                         Style="flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @tmpl.Description
                                </MudText>

                                <div class="d-flex justify-space-between align-center">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                                             Style="font-size: 0.6875rem;">
                                        @tmpl.StepCount steps
                                    </MudChip>

                                    @if (_usedWorkflowTemplates.Contains(tmpl.Name))
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Check" Disabled="true">
                                            Created
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="btn-gradient"
                                                   StartIcon="@Icons.Material.Filled.Add"
                                                   OnClick="@(() => UseWorkflowTemplate(tmpl))"
                                                   Disabled="@(_creatingTemplate == tmpl.Name)">
                                            @(_creatingTemplate == tmpl.Name ? "Creating..." : "Use Template")
                                        </MudButton>
                                    }
                                </div>
                            </div>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>

            @if (FilteredWorkflowTemplates.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="No workflow templates found"
                            Description="No workflow templates match your search or filters."
                            ActionText="Clear filters" OnAction="ClearWorkflowFilters" />
            }
        </div>
    </MudTabPanel>

    @* ──────────────── Assistant Templates ──────────────── *@
    <MudTabPanel Text="Assistants" Icon="@Icons.Material.Outlined.SmartToy"
                 BadgeData="@_assistantTemplates.Count" BadgeColor="Color.Secondary">
        <div class="pa-4">
            <div class="d-flex align-center gap-3 flex-wrap mb-3">
                <MudSelect T="string" Value="_assistantGroupFilter" ValueChanged="@((string g) => SetAssistantGroup(g))"
                           Label="Browse by area" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                           Style="min-width: 260px;">
                    <MudSelectItem Value="@AllGroupsLabel">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Apps" Size="Size.Small" Style="color: #6B7280;" />
                            <span>All Categories</span>
                        </div>
                    </MudSelectItem>
                    @foreach (var g in _assistantGroups)
                    {
                        <MudSelectItem Value="@g.Group">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@_groupIcons.GetValueOrDefault(g.Group, Icons.Material.Filled.Category)" Size="Size.Small" Style="@($"color: {_groupColors.GetValueOrDefault(g.Group, "#6B7280")};")" />
                                <span>@g.Group</span>
                            </div>
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @(CurrentAssistantChipCategories.Length - 1) categor@(CurrentAssistantChipCategories.Length - 1 == 1 ? "y" : "ies")
                    @(_assistantCategoryFilter != "All" ? $"· filtering by \"{_assistantCategoryFilter}\"" : "")
                </MudText>
                @if (_assistantCategoryFilter != "All" || _assistantGroupFilter != "Core & Industry" || !string.IsNullOrWhiteSpace(_searchTerm))
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FilterAltOff"
                               OnClick="@ClearAssistantFilters">
                        Clear filters
                    </MudButton>
                }
            </div>

            <div class="d-flex gap-2 flex-wrap mb-4"
                 style="@(_assistantGroupFilter == AllGroupsLabel ? "max-height: 130px; overflow-y: auto; padding-right: 4px;" : "")">
                @foreach (var cat in CurrentAssistantChipCategories)
                {
                    <MudChip T="string" Size="Size.Small"
                             Color="@(_assistantCategoryFilter == cat ? Color.Primary : Color.Default)"
                             Variant="@(_assistantCategoryFilter == cat ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => _assistantCategoryFilter = cat)">
                        @cat
                    </MudChip>
                }
            </div>

            <MudGrid Spacing="3" Class="stagger-in">
                @foreach (var tmpl in FilteredAssistantTemplates)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper Elevation="0" Style="@($"border: 1px solid var(--mud-palette-divider); border-left: 4px solid {GetAssistantTypeColor(tmpl.Type)}; border-radius: var(--r2-radius-md); height: 100%; display: flex; flex-direction: column;")">
                            <div class="pa-4" style="flex: 1; display: flex; flex-direction: column;">
                                <div class="d-flex align-center gap-3 mb-2">
                                    <MudAvatar Size="Size.Medium" Style="@($"background-color: {GetAssistantTypeColor(tmpl.Type)}; color: white;")">
                                        <MudIcon Icon="@GetAssistantTypeIcon(tmpl.Type)" Size="Size.Small" />
                                    </MudAvatar>
                                    <div style="flex: 1; min-width: 0;">
                                        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@tmpl.Name</MudText>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 Style="@($"color: {GetAssistantTypeColor(tmpl.Type)}; border-color: {GetAssistantTypeColor(tmpl.Type)}; font-size: 0.6875rem; height: 20px;")">
                                            @tmpl.Type
                                        </MudChip>
                                    </div>
                                </div>

                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3"
                                         Style="flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @tmpl.Description
                                </MudText>

                                <div class="d-flex justify-space-between align-center">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                                             Style="font-size: 0.6875rem;">
                                        @tmpl.Type type
                                    </MudChip>

                                    @if (_usedAssistantTemplates.Contains(tmpl.Name))
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Check" Disabled="true">
                                            Created
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="btn-gradient"
                                                   StartIcon="@Icons.Material.Filled.Add"
                                                   OnClick="@(() => UseAssistantTemplate(tmpl))"
                                                   Disabled="@(_creatingTemplate == tmpl.Name)">
                                            @(_creatingTemplate == tmpl.Name ? "Creating..." : "Use Template")
                                        </MudButton>
                                    }
                                </div>
                            </div>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>

            @if (FilteredAssistantTemplates.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="No assistant templates found"
                            Description="No assistant templates match your search or filters."
                            ActionText="Clear filters" OnAction="ClearAssistantFilters" />
            }
        </div>
    </MudTabPanel>
</MudTabs>

@code {
    private const string AllGroupsLabel = "All Categories";

    private int _activeTab;
    private string _searchTerm = string.Empty;
    private string _workflowCategoryFilter = "All";
    private string _assistantCategoryFilter = "All";
    private string _workflowGroupFilter = "Core & Industry";
    private string _assistantGroupFilter = "Core & Industry";
    private string? _creatingTemplate;
    private HashSet<string> _usedWorkflowTemplates = new();
    private HashSet<string> _usedAssistantTemplates = new();

    // Business Need taxonomy, grouped so the filter UI shows a manageable set of
    // chips at a time instead of one flat wall of 70+ categories.
    private static readonly (string Group, string[] Categories)[] _businessNeedGroups = {
        ("Sales", new[] { "Contract Management", "Forecasting", "Geolocation", "Lead & Opportunity Management", "Partner Management", "Quotes & Orders", "Sales Intelligence", "Sales Methodologies", "Sales Productivity" }),
        ("Marketing", new[] { "Account-Based Marketing", "Campaign Management", "Event Management", "Feeds", "Loyalty", "Marketing Automation", "Marketing Intelligence", "Mass Emails", "Personalization", "Social Channels", "Surveys", "Testing & Segmentation", "Websites" }),
        ("IT & Administration", new[] { "Admin & Developer Tools", "Audit & Compliance", "Augmented Reality (AR) & Virtual Reality (VR)", "Content Delivery Network (CDN)", "Content Management System (CMS)", "Data Backup & Storage", "Data Management", "Data Migration", "Developer Tools", "Information Management", "Integration", "IT Management", "Search & Recommendation", "Security", "Translation" }),
        ("Customer Service", new[] { "Agent Productivity", "Case Management", "Field Service", "Route Planning", "Telephony" }),
        ("Finance", new[] { "Accounting", "Compensation Management", "Grant Management", "Time & Expense" }),
        ("Analytics", new[] { "Analytics & Site Monitoring", "Dashboards & Reports", "Data Cleansing", "Data Visualization" }),
        ("Productivity", new[] { "Alerts", "Document Generation", "Document Management", "Email & Calendar Sync", "Process Management", "Project Management", "Time & Date" }),
        ("Commerce", new[] { "Ecommerce", "Live Commerce", "Marketplace", "Payments Processing", "Point of Sale (POS) & In-Store", "Product Information Management (PIM)", "Ratings & Reviews", "Shipping, Fulfillment & Logistics", "Subscriptions", "Warranty & Returns Management" }),
        ("Collaboration", new[] { "Chat & Web Conferencing", "Conversational Commerce" }),
        ("Enterprise Resource Planning", new[] { "Human Resources", "Order & Inventory Management System", "People Management", "Punchout System", "Warehouse Management System (WMS)" }),
    };

    private static readonly string[] _businessNeedCategories = _businessNeedGroups.SelectMany(g => g.Categories).ToArray();

    private static readonly string[] _workflowCoreCategories = { "Approval", "HR", "Finance", "IT", "Operations", "Steel", "Manufacturing", "Government", "Hospitality", "B2B" };
    private static readonly string[] _assistantCoreCategories = { "HR", "IT", "Finance", "Legal", "Procurement", "General", "Steel", "Government", "Hospitality", "B2B", "Website Agent" };

    private static readonly (string Group, string[] Categories)[] _workflowGroups =
        new[] { ("Core & Industry", _workflowCoreCategories) }.Concat(_businessNeedGroups).ToArray();
    private static readonly (string Group, string[] Categories)[] _assistantGroups =
        new[] { ("Core & Industry", _assistantCoreCategories) }.Concat(_businessNeedGroups).ToArray();

    private static readonly string[] _workflowCategories = new[] { "All" }.Concat(_workflowCoreCategories).Concat(_businessNeedCategories).ToArray();
    private static readonly string[] _assistantCategories = new[] { "All" }.Concat(_assistantCoreCategories).Concat(_businessNeedCategories).ToArray();

    private string[] CurrentWorkflowChipCategories =>
        _workflowGroupFilter == AllGroupsLabel
            ? _workflowCategories
            : new[] { "All" }.Concat(_workflowGroups.First(g => g.Group == _workflowGroupFilter).Categories).ToArray();

    private string[] CurrentAssistantChipCategories =>
        _assistantGroupFilter == AllGroupsLabel
            ? _assistantCategories
            : new[] { "All" }.Concat(_assistantGroups.First(g => g.Group == _assistantGroupFilter).Categories).ToArray();

    private void SetWorkflowGroup(string group)
    {
        _workflowGroupFilter = group;
        _workflowCategoryFilter = "All";
    }

    private void SetAssistantGroup(string group)
    {
        _assistantGroupFilter = group;
        _assistantCategoryFilter = "All";
    }

    private void ClearWorkflowFilters()
    {
        _workflowGroupFilter = "Core & Industry";
        _workflowCategoryFilter = "All";
        _searchTerm = string.Empty;
    }

    private void ClearAssistantFilters()
    {
        _assistantGroupFilter = "Core & Industry";
        _assistantCategoryFilter = "All";
        _searchTerm = string.Empty;
    }

    // Combined count for the search summary
    private List<object> FilteredItems => _activeTab == 0
        ? FilteredWorkflowTemplates.Cast<object>().ToList()
        : FilteredAssistantTemplates.Cast<object>().ToList();

    // ──────────────── Workflow Templates (55+) ────────────────
