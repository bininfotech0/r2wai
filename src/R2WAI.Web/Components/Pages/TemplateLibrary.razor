        new() { Name = "Blast Furnace Maintenance", Category = "Steel", StepCount = 5, Description = "Scheduled maintenance workflow for blast furnace operations.", Steps = "Plan Shutdown|Safety Clearance|Maintenance Execution|Testing|Restart" },
        new() { Name = "Raw Material Procurement", Category = "Steel", StepCount = 5, Description = "Iron ore and coal procurement with supplier evaluation.", Steps = "Requirement|Supplier Quote|Quality Check|PO Generation|Delivery Tracking" },
        new() { Name = "Steel Dispatch & Logistics", Category = "Steel", StepCount = 5, Description = "Order processing to delivery tracking for steel products.", Steps = "Order Confirm|Production Schedule|Quality Check|Loading|Dispatch & Track" },
        new() { Name = "Environmental Compliance - Steel", Category = "Steel", StepCount = 4, Description = "Pollution control and emission monitoring for steel plants.", Steps = "Emission Monitoring|Data Collection|SPCB Report|Corrective Action" },
        new() { Name = "Heat Treatment Process", Category = "Steel", StepCount = 4, Description = "Steel heat treatment workflow with temperature monitoring.", Steps = "Load Furnace|Temperature Control|Cooling Cycle|Hardness Testing" },

        // ── Manufacturing / Motor & Automation ──
        new() { Name = "Motor Assembly Line QC", Category = "Manufacturing", StepCount = 5, Description = "Motor assembly quality control with testing at each stage.", Steps = "Component Check|Winding Test|Assembly|Vibration Test|Final QC" },
        new() { Name = "PLC Program Deployment", Category = "Manufacturing", StepCount = 4, Description = "Deploy automation PLC programs with safety validation.", Steps = "Code Review|Simulation Test|Safety Validation|Deploy to PLC" },
