@inject NavigationManager Navigation
@inject IJSRuntime JS

@code {
    protected override async Task OnInitializedAsync()
    {
        var url = $"/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}";

        // Navigation.NavigateTo(url, forceLoad: true) tears the circuit down mid-flight:
        // its fire-and-forget JS interop call gets canceled by the resulting disconnect,
        // which the framework surfaces as an unhandled circuit exception (the red
        // "An unhandled error has occurred" banner), even though the redirect itself
        // still happens. Doing the navigation here ourselves lets us await it and
        // swallow that expected cancellation instead of letting it kill the circuit.
        try
        {
            await JS.InvokeVoidAsync("r2waiHardRedirect", url);
        }
        catch (Exception ex) when (ex is TaskCanceledException or JSDisconnectedException)
        {
        }
    }
}
