@page "/admin/member-events"
@attribute [Authorize(Roles = "Admin,SystemAdmin")]
@inject AuthenticatedHttpClient Http
@inject ISnackbar Snackbar

<PageTitle>R2WAI - Member Events</PageTitle>

<PageHeader Title="Member Events" Subtitle="Create rewards events and award points to members" />

<MudGrid Spacing="3">
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4 animate-slide-in" Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: var(--r2-radius-md);">
            <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight: 600;">New Event</MudText>
            <MudTextField @bind-Value="_newName" Label="Event Name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
            <MudNumericField @bind-Value="_newPoints" Label="Points Value" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
            <MudDatePicker @bind-Date="_newDate" Label="Event Date" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
            <MudTextField @bind-Value="_newDescription" Label="Description (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Class="mb-3" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="btn-gradient" FullWidth="true"
                       Disabled="@(_creating || string.IsNullOrWhiteSpace(_newName) || _newPoints <= 0)" OnClick="CreateEvent">
                @(_creating ? "Creating..." : "Create Event")
            </MudButton>
        </MudPaper>

        <MudPaper Class="pa-4 mt-4 animate-slide-in" Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: var(--r2-radius-md);">
            <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight: 600;">Award Points</MudText>
            <MudSelect T="Guid?" @bind-Value="_awardEventId" Label="Event" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                @foreach (var ev in _events.Where(e => e.IsActive))
                {
                    <MudSelectItem T="Guid?" Value="ev.Id">@ev.Name (@ev.PointsValue pts)</MudSelectItem>
                }
            </MudSelect>
            <MudAutocomplete T="MemberOption" @bind-Value="_awardMember" Label="Member" Variant="Variant.Outlined" Margin="Margin.Dense"
                              SearchFunc="SearchMembers" ToStringFunc="@(m => m is null ? string.Empty : $"{m.FirstName} {m.LastName} ({m.Email ?? m.MobileNumber})")"
                              Class="mb-3" Placeholder="Search by name, email, or mobile..." />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="btn-gradient" FullWidth="true"
                       Disabled="@(_awarding || _awardEventId is null || _awardMember is null)" OnClick="AwardPoints">
                @(_awarding ? "Awarding..." : "Award Points")
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4 animate-slide-in" Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: var(--r2-radius-md);">
            <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight: 600;">Events</MudText>
            @if (_loading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            else if (_events.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.Event" Title="No events yet" Description="Create an event to start awarding points." MinHeight="200px" />
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Points</th>
                            <th>Date</th>
                            <th>Attendance</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in _events)
                        {
                            <tr>
                                <td>@ev.Name</td>
                                <td>@ev.PointsValue</td>
                                <td>@ev.EventDate.ToLocalTime().ToString("d")</td>
                                <td>@ev.AttendanceCount</td>
                                <td>
                                    <MudChip T="string" Size="Size.Small" Color="@(ev.IsActive ? Color.Success : Color.Default)">
                                        @(ev.IsActive ? "Active" : "Inactive")
                                    </MudChip>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private List<EventDto> _events = new();
    private bool _loading = true;

    private string _newName = string.Empty;
    private int _newPoints = 100;
    private DateTime? _newDate = DateTime.Today;
    private string _newDescription = string.Empty;
    private bool _creating;

    private Guid? _awardEventId;
    private MemberOption? _awardMember;
    private bool _awarding;

    protected override async Task OnInitializedAsync() => await LoadEvents();

    private async Task LoadEvents()
    {
        _loading = true;
        try
        {
            _events = await Http.GetFromJsonAsync<List<EventDto>>("/api/v1/admin/members/events?includeInactive=true") ?? new();
        }
        catch { Snackbar.Add("Failed to load events.", Severity.Warning); }
        finally { _loading = false; }
    }

    private async Task CreateEvent()
    {
        _creating = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/v1/admin/members/events", new
            {
                Name = _newName,
                PointsValue = _newPoints,
                EventDate = _newDate ?? DateTime.Today,
                Description = string.IsNullOrWhiteSpace(_newDescription) ? null : _newDescription,
            });

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Event created.", Severity.Success);
                _newName = string.Empty;
                _newDescription = string.Empty;
                _newPoints = 100;
                await LoadEvents();
            }
            else
            {
                Snackbar.Add("Failed to create event.", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _creating = false; }
    }

    private async Task<IEnumerable<MemberOption>> SearchMembers(string search, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(search)) return [];
        try
        {
            var result = await Http.GetFromJsonAsync<UsersResult>($"/api/v1/admin/users?page=1&pageSize=10&search={Uri.EscapeDataString(search)}");
            return result?.Items ?? [];
        }
        catch { return []; }
    }

    private async Task AwardPoints()
    {
        if (_awardEventId is null || _awardMember is null) return;
        _awarding = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/v1/admin/members/events/award-points", new
            {
                EventId = _awardEventId,
                UserId = _awardMember.Id,
            });

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Points awarded to {_awardMember.FirstName} {_awardMember.LastName}.", Severity.Success);
                _awardMember = null;
                await LoadEvents();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add(TryExtractErrorMessage(body) ?? "Failed to award points.", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _awarding = false; }
    }

    private static string? TryExtractErrorMessage(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("detail", out var detail))
                return detail.GetString();
        }
        catch { }
        return null;
    }

    private class EventDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public int PointsValue { get; set; }
        public DateTime EventDate { get; set; }
        public bool IsActive { get; set; }
        public int AttendanceCount { get; set; }
    }

    private class UsersResult { public List<MemberOption> Items { get; set; } = new(); }

    private class MemberOption
    {
        public Guid Id { get; set; }
        public string? Email { get; set; }
        public string? MobileNumber { get; set; }
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
    }
}
