@page "/settings"
@attribute [Authorize]
@inject NavigationManager Navigation

<PageTitle>R2WAI - Settings</PageTitle>

<PageHeader Title="Settings" Subtitle="Manage your platform configuration" />

<MudGrid Spacing="3" Class="stagger-in">
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="0" Class="pa-4 studio-card studio-card--primary hover-lift" Style="cursor: pointer; height: 100%;"
                  @onclick="@(() => Navigation.NavigateTo("/admin/users"))" @onkeydown="@(e => NavigateOnEnter(e, "/admin/users"))"
                  tabindex="0" role="button" aria-label="Users settings">
            <div class="d-flex align-center gap-3 mb-3">
                <MudAvatar Color="Color.Primary" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Outlined.PeopleAlt" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Users</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Manage user accounts and invitations</MudText>
                </div>
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Create, edit, and deactivate user accounts. Send invitations and manage access.
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="0" Class="pa-4 studio-card studio-card--secondary hover-lift" Style="cursor: pointer; height: 100%;"
                  @onclick="@(() => Navigation.NavigateTo("/admin/roles"))" @onkeydown="@(e => NavigateOnEnter(e, "/admin/roles"))"
                  tabindex="0" role="button" aria-label="Roles settings">
            <div class="d-flex align-center gap-3 mb-3">
                <MudAvatar Color="Color.Secondary" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Outlined.Shield" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Roles</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Define roles and assign to users</MudText>
                </div>
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Create custom roles with specific access levels for your organization.
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="0" Class="pa-4 studio-card studio-card--tertiary hover-lift" Style="cursor: pointer; height: 100%;"
                  @onclick="@(() => Navigation.NavigateTo("/admin/permissions"))" @onkeydown="@(e => NavigateOnEnter(e, "/admin/permissions"))"
                  tabindex="0" role="button" aria-label="Permissions settings">
            <div class="d-flex align-center gap-3 mb-3">
                <MudAvatar Color="Color.Tertiary" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Permissions</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Role-permission matrix</MudText>
                </div>
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Configure exactly which features each role can access with the visual permission grid.
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="0" Class="pa-4 studio-card studio-card--primary hover-lift" Style="cursor: pointer; height: 100%;"
                  @onclick="@(() => Navigation.NavigateTo("/admin/models"))" @onkeydown="@(e => NavigateOnEnter(e, "/admin/models"))"
                  tabindex="0" role="button" aria-label="AI Models settings">
            <div class="d-flex align-center gap-3 mb-3">
                <MudAvatar Color="Color.Info" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Outlined.ModelTraining" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">AI Models</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Configure AI providers</MudText>
                </div>
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Set up OpenAI, Azure OpenAI, or Ollama models. Test connections and set defaults.
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="0" Class="pa-4 studio-card studio-card--secondary hover-lift" Style="cursor: pointer; height: 100%;"
                  @onclick="@(() => Navigation.NavigateTo("/admin/security"))" @onkeydown="@(e => NavigateOnEnter(e, "/admin/security"))"
                  tabindex="0" role="button" aria-label="Security settings">
            <div class="d-flex align-center gap-3 mb-3">
                <MudAvatar Color="Color.Warning" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Outlined.Lock" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Security</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Password and session policies</MudText>
                </div>
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Configure password requirements, session timeouts, and authentication enforcement.
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="0" Class="pa-4 studio-card studio-card--tertiary hover-lift" Style="cursor: pointer; height: 100%;"
                  @onclick="@(() => Navigation.NavigateTo("/settings/tenant"))" @onkeydown="@(e => NavigateOnEnter(e, "/settings/tenant"))"
                  tabindex="0" role="button" aria-label="Tenant settings">
            <div class="d-flex align-center gap-3 mb-3">
                <MudAvatar Color="Color.Success" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Outlined.Domain" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Tenant</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Organization settings</MudText>
                </div>
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Configure organization name, domain, feature flags, and usage limits.
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="0" Class="pa-4 studio-card studio-card--secondary hover-lift" Style="cursor: pointer; height: 100%;"
                  @onclick="@(() => Navigation.NavigateTo("/governance/departments"))" @onkeydown="@(e => NavigateOnEnter(e, "/governance/departments"))"
                  tabindex="0" role="button" aria-label="Departments settings">
            <div class="d-flex align-center gap-3 mb-3">
                <MudAvatar Color="Color.Success" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Outlined.AccountBalance" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Departments</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Organize applications by department</MudText>
                </div>
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Create and manage the departments applications and users belong to.
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="0" Class="pa-4 studio-card studio-card--tertiary hover-lift" Style="cursor: pointer; height: 100%;"
                  @onclick="@(() => Navigation.NavigateTo("/admin/webhooks"))" @onkeydown="@(e => NavigateOnEnter(e, "/admin/webhooks"))"
                  tabindex="0" role="button" aria-label="Webhooks settings">
            <div class="d-flex align-center gap-3 mb-3">
                <MudAvatar Color="Color.Tertiary" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Outlined.Webhook" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Webhooks</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Outbound event notifications</MudText>
                </div>
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Register endpoints that receive events from R2WAI as they happen.
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="0" Class="pa-4 studio-card studio-card--primary hover-lift" Style="cursor: pointer; height: 100%;"
                  @onclick="@(() => Navigation.NavigateTo("/admin/api-keys"))" @onkeydown="@(e => NavigateOnEnter(e, "/admin/api-keys"))"
                  tabindex="0" role="button" aria-label="API Keys settings">
            <div class="d-flex align-center gap-3 mb-3">
                <MudAvatar Color="Color.Info" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Outlined.Key" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">API Keys</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Manage external API credentials</MudText>
                </div>
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Issue and revoke API keys used to authenticate external integrations.
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="0" Class="pa-4 studio-card studio-card--secondary hover-lift" Style="cursor: pointer; height: 100%;"
                  @onclick="@(() => Navigation.NavigateTo("/admin/content-moderation"))" @onkeydown="@(e => NavigateOnEnter(e, "/admin/content-moderation"))"
                  tabindex="0" role="button" aria-label="Content Moderation settings">
            <div class="d-flex align-center gap-3 mb-3">
                <MudAvatar Color="Color.Warning" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Outlined.Security" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Content Moderation</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Governance policy rules</MudText>
                </div>
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Configure content and behavior rules assistants must follow.
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudPaper Elevation="0" Class="pa-4 studio-card studio-card--tertiary hover-lift" Style="cursor: pointer; height: 100%;"
                  @onclick="@(() => Navigation.NavigateTo("/governance"))" @onkeydown="@(e => NavigateOnEnter(e, "/governance"))"
                  tabindex="0" role="button" aria-label="Governance (Advanced) settings">
            <div class="d-flex align-center gap-3 mb-3">
                <MudAvatar Color="Color.Secondary" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Outlined.Shield" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Governance (Advanced)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Tenant-wide policy overview</MudText>
                </div>
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Advanced cross-cutting governance settings for the whole tenant.
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private void NavigateOnEnter(KeyboardEventArgs e, string url)
    {
        if (e.Key is "Enter" or " ") Navigation.NavigateTo(url);
    }
}
