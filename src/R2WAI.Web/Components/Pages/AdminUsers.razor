@page "/admin/users"
@attribute [Authorize(Roles = "Admin,SystemAdmin")]
@inject AuthenticatedHttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>R2WAI - User Management</PageTitle>

<PageHeader Title="User Management" Subtitle="Manage platform users and their access">
    <MudTooltip Text="Dev-only: generates fake member accounts for load testing. Returns 404 outside Development.">
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.Groups" OnClick="SeedTestMembers" Disabled="_seeding">
            @(_seeding ? "Seeding..." : "Seed 5000 Test Members")
        </MudButton>
    </MudTooltip>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
               Class="btn-gradient"
               StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenCreateUserDialog">
        Invite User
    </MudButton>
</PageHeader>

<MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: var(--r2-radius-md);" Class="admin-page animate-slide-in">
    @if (_selectedUsers.Count > 0)
    {
        <div class="d-flex align-center gap-2 pa-3">
            <MudText Typo="Typo.body2" Style="font-weight: 600;">@_selectedUsers.Count selected</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="BulkDeleteUsers">
                Delete Selected
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                       OnClick="@(() => _selectedUsers.Clear())">
                Clear
            </MudButton>
        </div>
    }
    <MudDataGrid T="UserDto" Items="FilteredUsers" Hover="true" Dense="true" Loading="_loading" Elevation="0"
                 MultiSelection="true" @bind-SelectedItems="_selectedUsers">
        <ToolBarContent>
            <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Placeholder="Search users..." Immediate="true" DebounceInterval="300"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 260px;" />
            <MudSelect T="string" Value="_roleFilter" ValueChanged="@((string v) => _roleFilter = v)"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 180px;" Class="ml-2">
                <MudSelectItem T="string" Value="@("All Roles")">All Roles</MudSelectItem>
                @foreach (var role in _availableRoles)
                {
                    <MudSelectItem T="string" Value="@role.Name">@role.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSpacer />
            <MudText Typo="Typo.caption" Color="Color.Secondary">@_users.Count of @_totalCount users</MudText>
        </ToolBarContent>
        <Columns>
            <SelectColumn T="UserDto" />
            <TemplateColumn Title="User" SortBy="@(x => x.Email)">
                <CellTemplate>
                    <div class="d-flex align-center gap-2">
                        <MudAvatar Size="Size.Small" Color="Color.Primary" Style="width: 28px; height: 28px; font-size: 0.7rem;">
                            @(!string.IsNullOrEmpty(context.Item.Email) ? context.Item.Email[0].ToString().ToUpper() : context.Item.FirstName.Length > 0 ? context.Item.FirstName[0].ToString().ToUpper() : "U")
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.body2" Style="font-weight: 500;">@context.Item.FirstName @context.Item.LastName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(context.Item.Email ?? context.Item.MobileNumber ?? "—")
                                @if (context.Item.HasAadhaar)
                                {
                                    <MudTooltip Text="Aadhaar linked">
                                        <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" Color="Color.Success" Style="vertical-align: middle; margin-left: 4px; font-size: 0.9rem;" />
                                    </MudTooltip>
                                }
                            </MudText>
                        </div>
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Roles">
                <CellTemplate>
                    <div class="d-flex gap-1 flex-wrap">
                        @foreach (var role in context.Item.Roles)
                        {
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(role.Contains("Admin") ? Color.Primary : Color.Default)"
                                     Variant="@(role.Contains("Admin") ? Variant.Filled : Variant.Outlined)">@role</MudChip>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Actions" Sortable="false" Filterable="false">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => OpenEditUserDialog(context.Item))" aria-label="Edit" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => DeleteUser(context.Item))" aria-label="Delete" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            @if (_users.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.PeopleAlt" Title="No users found"
                            Description="Invite users to start collaborating." MinHeight="200px" />
            }
            else
            {
                <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="No users match your search"
                            Description="Try a different name or email." ActionText="Clear search"
                            OnAction="@(() => OnSearchChanged(string.Empty))" MinHeight="200px" />
            }
        </NoRecordsContent>
    </MudDataGrid>
    @if (_hasMore && !_loading)
    {
        <div class="d-flex justify-center pa-3">
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                       OnClick="LoadMore" StartIcon="@Icons.Material.Filled.ExpandMore">
                Load More (@(_totalCount - _users.Count) remaining)
            </MudButton>
        </div>
    }
</MudPaper>

@code {
    private List<UserDto> _users = new();
    private HashSet<UserDto> _selectedUsers = new();
    private bool _loading = true;
    private string _search = string.Empty;
    private int _page = 1;
    private const int _pageSize = 20;
    private int _totalCount;
    private bool _hasMore;
    private bool _seeding;
    private string _roleFilter = "All Roles";
    private List<RoleOption> _availableRoles = new();

    private IEnumerable<UserDto> FilteredUsers =>
        _roleFilter == "All Roles" ? _users : _users.Where(u => u.Roles.Contains(_roleFilter));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadData();
            await LoadRoles();
        }
    }

    private async Task LoadRoles()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<RolesResult>("/api/v1/admin/roles?pageSize=100");
            _availableRoles = result?.Items ?? new();
            StateHasChanged();
        }
        catch { /* role filter is a convenience; ignore failures */ }
    }

    private async Task LoadData()
    {
        _page = 1;
        _users.Clear();
        await LoadDataPage();
    }

    private async Task LoadDataPage()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var search = string.IsNullOrWhiteSpace(_search) ? "" : $"&search={Uri.EscapeDataString(_search)}";
            var result = await Http.GetFromJsonAsync<UsersResult>($"/api/v1/admin/users?page={_page}&pageSize={_pageSize}{search}");
            _users.AddRange(result?.Items ?? new());
            _totalCount = result?.TotalCount ?? _users.Count;
            _hasMore = _users.Count < _totalCount;
        }
        catch { Snackbar.Add("Failed to load users", Severity.Warning); }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task LoadMore()
    {
        _page++;
        await LoadDataPage();
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        await LoadData();
    }

    private async Task OpenCreateUserDialog()
    {
        var dialog = await Dialog.ShowAsync<CreateEditUserDialog>("Invite User");
        var result = await dialog.Result;
        if (result?.Canceled == false) await LoadData();
    }

    private async Task OpenEditUserDialog(UserDto user)
    {
        var parameters = new DialogParameters<CreateEditUserDialog> { { x => x.EditId, user.Id.ToString() } };
        var dialog = await Dialog.ShowAsync<CreateEditUserDialog>("Edit User", parameters);
        var result = await dialog.Result;
        if (result?.Canceled == false) await LoadData();
    }

    private async Task DeleteUser(UserDto user)
    {
        var parameters = new DialogParameters<DeleteConfirmationDialog>
        {
            { x => x.ItemName, user.Email ?? $"{user.FirstName} {user.LastName}" },
            { x => x.Description, "This user will lose access to the platform." }
        };
        var dialog = await Dialog.ShowAsync<DeleteConfirmationDialog>("Confirm Delete", parameters);
        var result = await dialog.Result;
        if (result?.Canceled != false) return;

        try
        {
            await Http.DeleteAsync($"/api/v1/admin/users/{user.Id}");
            Snackbar.Add("User deleted", Severity.Success);
            await LoadData();
        }
        catch (Exception ex) { Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error); }
    }

    private async Task BulkDeleteUsers()
    {
        var ids = _selectedUsers.Select(u => u.Id).ToArray();
        if (ids.Length == 0) return;

        var parameters = new DialogParameters<DeleteConfirmationDialog>
        {
            { x => x.ItemName, $"{ids.Length} user{(ids.Length == 1 ? "" : "s")}" }
        };
        var dialog = await Dialog.ShowAsync<DeleteConfirmationDialog>("Confirm Delete", parameters);
        var result = await dialog.Result;
        if (result?.Canceled != false) return;

        try
        {
            await Http.PostAsJsonAsync("/api/v1/admin/users/bulk-delete", new { Ids = ids });
            Snackbar.Add($"{ids.Length} user{(ids.Length == 1 ? "" : "s")} deleted", Severity.Success);
            _selectedUsers.Clear();
            await LoadData();
        }
        catch (Exception ex) { Snackbar.Add($"Bulk delete failed: {ex.Message}", Severity.Error); }
    }

    private async Task SeedTestMembers()
    {
        _seeding = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/v1/admin/dev/seed-test-members?count=5000", new { });
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Seeded 5000 test members.", Severity.Success);
                await LoadData();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                Snackbar.Add("Test member seeding is only available in a Development environment.", Severity.Warning);
            }
            else
            {
                Snackbar.Add("Failed to seed test members.", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _seeding = false; }
    }

    private class UsersResult { public List<UserDto> Items { get; set; } = new(); public int TotalCount { get; set; } }
    private class RolesResult { public List<RoleOption> Items { get; set; } = new(); }
    private class RoleOption { public Guid Id { get; set; } public string Name { get; set; } = string.Empty; }
    private class UserDto
    {
        public Guid Id { get; set; }
        public string? Email { get; set; }
        public string? MobileNumber { get; set; }
        public bool HasAadhaar { get; set; }
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string[] Roles { get; set; } = [];
    }
}
