    // --- Generator ---
    private void ApplyTemplate(string type)
    {
        _generatorPrompt = type switch
        {
            "application-approval" => "Create an application approval workflow. Citizen submits an application, an officer reviews it, and if approved the applicant is notified; if rejected the applicant is notified with the reason.",
            "document-verification" => "Create a document verification workflow. Citizen uploads documents, an officer verifies their authenticity, and the applicant is notified of the verification result.",
            "citizen-complaint" => "Create a citizen complaint workflow. Citizen submits a complaint, it is assigned to the relevant department, an officer responds, and the citizen is notified of the resolution.",
            "payment-approval" => "Create a payment approval workflow. Payments under ₹50,000 auto-approve. ₹50,000 to ₹5,00,000 require officer approval. Above ₹5,00,000 require officer and department head approval. Notify the payer after each decision.",
            "certificate-generation" => "Create a certificate generation workflow. Officer reviews the application and supporting documents, approves it, the certificate is generated, and the citizen is notified it is ready.",
            "department-escalation" => "Create a department escalation workflow. A case is reviewed by an officer; if not resolved within the target time it escalates to a senior officer for approval, then the requester is notified.",
            "employee-request" => "Create an employee request workflow. Employee submits a request, manager approves or rejects it, and the employee is notified of the outcome.",
            _ => _generatorPrompt
        };
    }

    private async Task GenerateWorkflow()
    {
        _generating = true;
        _genStep = 0;
        StateHasChanged();

        await Task.Delay(800);
        _genStep = 1;
        StateHasChanged();

        var prompt = _generatorPrompt.ToLowerInvariant();
        var type = "General";
        if (prompt.Contains("payment")) type = "Finance";
        else if (prompt.Contains("complaint")) type = "Citizen Services";
        else if (prompt.Contains("certificate") || prompt.Contains("document")) type = "Records";
        else if (prompt.Contains("escalat")) type = "Governance";
        else if (prompt.Contains("employee")) type = "HR";
        else if (prompt.Contains("application") || prompt.Contains("approval")) type = "Approvals";

        var name = "AI Generated Automation";
        if (prompt.Contains("document verification")) name = "Document Verification Flow";
        else if (prompt.Contains("complaint")) name = "Citizen Complaint Flow";
        else if (prompt.Contains("payment")) name = "Payment Approval Flow";
        else if (prompt.Contains("certificate")) name = "Certificate Generation Flow";
        else if (prompt.Contains("escalat")) name = "Department Escalation Flow";
        else if (prompt.Contains("employee")) name = "Employee Request Flow";
        else if (prompt.Contains("application")) name = "Application Approval Flow";

        var steps = new List<object>();
        if (prompt.Contains("document verification") || prompt.Contains("verifies their authenticity"))
        {
            steps.Add(new { Name = "Upload Documents", Action = "Action", Order = 0 });
            steps.Add(new { Name = "Verify Authenticity", Action = "Approval", AssignedRole = "Officer", Order = 1 });
            steps.Add(new { Name = "Notify Applicant", Action = "Email", Order = 2 });
        }
        else if (prompt.Contains("complaint"))
        {
            steps.Add(new { Name = "Submit Complaint", Action = "Action", Order = 0 });
            steps.Add(new { Name = "Assign to Department", Action = "Action", Order = 1 });
            steps.Add(new { Name = "Officer Response", Action = "Approval", AssignedRole = "Officer", Order = 2 });
            steps.Add(new { Name = "Notify Citizen", Action = "Email", Order = 3 });
        }
        else if (prompt.Contains("certificate"))
        {
            steps.Add(new { Name = "Review Application", Action = "Approval", AssignedRole = "Officer", Order = 0 });
            steps.Add(new { Name = "Generate Certificate", Action = "Action", Order = 1 });
            steps.Add(new { Name = "Notify Citizen", Action = "Email", Order = 2 });
        }
        else if (prompt.Contains("escalat"))
        {
            steps.Add(new { Name = "Officer Review", Action = "Approval", AssignedRole = "Officer", Order = 0 });
            steps.Add(new { Name = "Escalate If Overdue", Action = "Condition", Order = 1 });
            steps.Add(new { Name = "Senior Officer Review", Action = "Approval", AssignedRole = "Senior Officer", Order = 2 });
            steps.Add(new { Name = "Notify Requester", Action = "Email", Order = 3 });
        }
        else if (prompt.Contains("payment"))
        {
            steps.Add(new { Name = "Submit Payment", Action = "Action", Order = 0 });
            steps.Add(new { Name = "Officer Approval", Action = "Approval", AssignedRole = "Officer", Order = 1 });
            if (prompt.Contains("department head"))
                steps.Add(new { Name = "Department Head Approval", Action = "Approval", AssignedRole = "Department Head", Order = 2 });
            steps.Add(new { Name = "Notify Payer", Action = "Email", Order = steps.Count });
        }
        else if (prompt.Contains("employee"))
        {
            steps.Add(new { Name = "Submit Request", Action = "Action", Order = 0 });
            steps.Add(new { Name = "Manager Approval", Action = "Approval", AssignedRole = "Manager", Order = 1 });
            steps.Add(new { Name = "Notify Employee", Action = "Email", Order = 2 });
        }
        else if (prompt.Contains("approval") || prompt.Contains("approve"))
        {
            steps.Add(new { Name = "Submit Application", Action = "Action", Order = 0 });
            steps.Add(new { Name = "Officer Review", Action = "Approval", AssignedRole = "Officer", Order = 1 });
            steps.Add(new { Name = "Notify Applicant", Action = "Email", Order = 2 });
        }
        else
        {
            steps.Add(new { Name = "Initiate", Action = "Action", Order = 0 });
            steps.Add(new { Name = "Process", Action = "Action", Order = 1 });
            steps.Add(new { Name = "Complete", Action = "Action", Order = 2 });
        }

        await Task.Delay(600);
        _genStep = 2;
        StateHasChanged();

        try
        {
            var stepsJson = System.Text.Json.JsonSerializer.Serialize(steps);
            var response = await Http.PostAsJsonAsync("/api/v1/workflows", new
            {
                Name = name,
                Description = _generatorPrompt.Length > 300 ? _generatorPrompt[..300] : _generatorPrompt,
                Type = type,
                Steps = stepsJson
            });

            if (response.IsSuccessStatusCode)
            {
                _genStep = 3;
                StateHasChanged();
                await Task.Delay(500);

                Snackbar.Add($"Automation '{name}' created! Open the designer to customize.", Severity.Success);
                _showGenerator = false;
                _generating = false;
                await LoadWorkflows();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed: {error}", Severity.Error);
                _generating = false;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed: {ex.Message}", Severity.Error);
            _generating = false;
        }
        StateHasChanged();
    }

