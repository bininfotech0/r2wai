    private async Task LoadWorkflowsPage()
    {
        _loadingWorkflows = true;
        _hasError = false;
        try
        {
            var search = string.IsNullOrWhiteSpace(_workflowSearch) ? "" : $"&search={Uri.EscapeDataString(_workflowSearch)}";
            var result = await Http.GetFromJsonAsync<ListResult<WorkflowDto>>(
                $"/api/v1/workflows?page={_wfPage}&pageSize={_wfPageSize}{search}");
            _workflows.AddRange(result?.Items ?? new());
            _wfTotalCount = result?.TotalCount ?? _workflows.Count;
            _wfHasMore = _workflows.Count < _wfTotalCount;
        }
        catch (Exception ex)
        {
            _hasError = true;
            _error = "Unable to load automations. Please check your connection and try again.";
            Snackbar.Add($"Failed to load automations: {ex.Message}", Severity.Error);
        }
        finally { _loadingWorkflows = false; }
    }

