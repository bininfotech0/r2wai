                                            </MudText>
                                        }
                                    </div>
                                </div>
                                <div class="d-flex gap-1">
                                    <MudSwitch T="bool" Value="schedule.IsActive" Color="Color.Success" Size="Size.Small"
                                               ValueChanged="@(val => ToggleSchedule(schedule, val))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   OnClick="@(() => EditSchedule(schedule))" aria-label="Edit schedule" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => DeleteSchedule(schedule))" aria-label="Delete schedule" />
                                </div>
                            </div>
                        </MudPaper>
                    }
                </div>
            }
        </div>
    </MudTabPanel>

    @* Integrations Tab *@
