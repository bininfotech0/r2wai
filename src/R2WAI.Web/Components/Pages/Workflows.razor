                                    <div>
                                        <div class="d-flex align-center gap-2">
                                            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@schedule.Name</MudText>
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@(schedule.IsActive ? Color.Success : Color.Default)"
                                                     Variant="Variant.Filled" Style="font-size: 0.6875rem; height: 20px;">
                                                @(schedule.IsActive ? "Active" : "Paused")
                                            </MudChip>
                                        </div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@schedule.WorkflowName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
