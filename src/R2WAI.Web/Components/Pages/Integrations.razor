@page "/workflow-studio/integrations"
@attribute [Authorize]
@inject AuthenticatedHttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>R2WAI - Integrations</PageTitle>

<PageHeader Title="Integrations" Subtitle="Connect to external systems and APIs">
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
        Add Integration
    </MudButton>
</PageHeader>

<MudTextField @bind-Value="_searchTerm" Placeholder="Search integrations..."
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
              Class="mb-5" Style="max-width: 420px;" />

@* ──────────────────── Installed Integrations ──────────────────── *@
<div class="mb-6">
    <div class="d-flex align-center justify-space-between mb-3">
        <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Installed (@FilteredIntegrations.Count())</MudText>
        @if (!_loading && _integrations.Count > 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">@FilteredIntegrations.Count() of @_integrations.Count shown</MudText>
        }
    </div>

    @if (_loading)
    {
        <LoadingSkeleton Variant="LoadingSkeleton.SkeletonVariant.Cards" />
    }
    else if (_integrations.Count == 0)
    {
        <MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-divider);">
            <EmptyState Icon="@Icons.Material.Outlined.Extension" Title="No integrations installed yet"
                        Description="Browse the Connector Marketplace below to add your first integration." MinHeight="200px" />
        </MudPaper>
    }
    else if (!FilteredIntegrations.Any())
    {
        <MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-divider);">
            <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="No integrations match your search"
                        Description="Try a different name." ActionText="Clear search"
                        OnAction="@(() => _searchTerm = string.Empty)" MinHeight="200px" />
        </MudPaper>
    }
    else
    {
        <MudGrid Spacing="3">
            @foreach (var integration in FilteredIntegrations)
            {
                var category = GetIntegrationCategory(integration);
                <MudItem xs="12" md="6" xl="4">
                    <MudPaper Elevation="0" Class="pa-4 integration-card">
                        <div class="d-flex align-start justify-space-between gap-2">
                            <div class="d-flex align-center gap-3" style="min-width: 0;">
                                <MudAvatar Size="Size.Medium" Style="@($"background-color: {GetCategoryColor(category)}1A; color: {GetCategoryColor(category)};")">
                                    <MudIcon Icon="@GetCategoryIcon(category)" Size="Size.Small" />
                                </MudAvatar>
                                <div style="min-width: 0;">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600;" Class="text-truncate">@integration.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@category</MudText>
                                </div>
                            </div>
                            <StatusBadge Status="@(integration.IsActive ? "Active" : "Inactive")" />
                        </div>

                        @if (NeedsSetup(integration))
                        {
                            <MudTooltip Text="Endpoint URL contains template placeholders or credentials are not configured — edit to add your account values and auth token">
                                <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small"
                                         Icon="@Icons.Material.Outlined.Warning" Class="mt-3">
                                    Setup Required
                                </MudChip>
                            </MudTooltip>
                        }

                        <div class="d-flex align-center justify-space-between mt-3 gap-2">
                            @if (_healthChecks.TryGetValue(integration.Id, out var check))
                            {
                                <MudTooltip Text="@check.Message">
                                    <div class="d-flex align-center gap-1">
                                        <MudIcon Icon="@(check.Success ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
                                                 Color="@(check.Success ? Color.Success : Color.Error)" Size="Size.Small" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Checked @FormatRelativeTime(check.At)</MudText>
                                    </div>
                                </MudTooltip>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Added @integration.CreatedAt.ToString("yyyy-MM-dd")</MudText>
                            }
                            <div class="d-flex gap-1">
                                <MudTooltip Text="Test connection">
                                    <MudIconButton Icon="@Icons.Material.Filled.NetworkCheck" Size="Size.Small" Color="Color.Info"
                                                   Disabled="@(_testingId == integration.Id)"
                                                   OnClick="@(() => TestIntegration(integration))" aria-label="Test connection" />
                                </MudTooltip>
                                <MudTooltip Text="@(integration.IsActive ? "Deactivate" : "Activate")">
                                    <MudIconButton Icon="@(integration.IsActive ? Icons.Material.Filled.ToggleOn : Icons.Material.Filled.ToggleOff)"
                                                   Size="Size.Small"
                                                   Color="@(integration.IsActive ? Color.Success : Color.Default)"
                                                   OnClick="@(() => ToggleIntegration(integration))"
                                                   aria-label="@(integration.IsActive ? "Deactivate" : "Activate")" />
                                </MudTooltip>
                                <MudTooltip Text="Configure">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   OnClick="@(() => OpenEditDialog(integration))" aria-label="Configure" />
                                </MudTooltip>
                                <MudTooltip Text="Delete">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => DeleteIntegration(integration))" aria-label="Delete" />
                                </MudTooltip>
                            </div>
                        </div>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</div>

@* ──────────────────── Connector Marketplace ──────────────────── *@
<div>
    <div class="d-flex justify-space-between align-center mb-2">
        <div>
            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Available Integrations</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Pre-built connectors — click to install</MudText>
        </div>
        <MudIcon Icon="@Icons.Material.Outlined.Store" Color="Color.Primary" />
    </div>

    <div class="d-flex gap-2 flex-wrap mb-4">
        @foreach (var cat in _allCategories)
        {
            <MudChip T="string" Size="Size.Small"
                     Color="@(_categoryFilter == cat ? Color.Primary : Color.Default)"
                     Variant="@(_categoryFilter == cat ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => _categoryFilter = cat)">
                @cat
            </MudChip>
        }
    </div>

    <MudGrid Spacing="3">
        @foreach (var connector in FilteredConnectors)
        {
            var installed = _installedConnectors.Contains(connector.Name);
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="0" Class="@("pa-4 " + (installed ? "integration-tile integration-tile--installed" : "integration-tile integration-tile--available"))">
                    <div class="d-flex align-center gap-3 mb-3">
                        <MudAvatar Size="Size.Medium" Style="@($"background-color: {GetCategoryColor(connector.Category)}; color: white;")">
                            <MudIcon Icon="@GetCategoryIcon(connector.Category)" Size="Size.Small" />
                        </MudAvatar>
                        <div style="flex: 1; min-width: 0;">
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@connector.Name</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Style="@($"color: {GetCategoryColor(connector.Category)}; border-color: {GetCategoryColor(connector.Category)}; font-size: 0.6875rem; height: 20px;")">
                                @connector.Category
                            </MudChip>
                        </div>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3"
                             Style="flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        @connector.Description
                    </MudText>
                    <div>
                        @if (installed)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Check" Disabled="true" FullWidth="true">
                                Installed
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Download"
                                       OnClick="@(() => InstallConnector(connector))" FullWidth="true"
                                       Disabled="@(_installingConnector == connector.Name)">
                                @(_installingConnector == connector.Name ? "Installing..." : "Install")
                            </MudButton>
                        }
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
</div>

@code {
    private List<IntegrationDto> _integrations = new();
    private string _searchTerm = string.Empty;
    private bool _loading = true;
    private readonly Dictionary<Guid, (bool Success, string Message, DateTime At)> _healthChecks = new();
    private Guid? _testingId;

    // Marketplace
    private string _categoryFilter = "All";
    private HashSet<string> _installedConnectors = new();
    private string? _installingConnector;

    private static readonly string[] _allCategories = { "All", "CRM", "Communication", "Storage", "DevOps", "Finance", "HR", "AI Automation" };

    private static readonly List<ConnectorTemplate> _marketplaceConnectors = new()
    {
        // CRM
        new() { Name = "Salesforce CRM", Category = "CRM", Endpoint = "https://login.salesforce.com", AuthType = "OAuth2",
                 Description = "Connect to Salesforce for lead management, opportunity tracking, and customer data sync." },
        new() { Name = "HubSpot", Category = "CRM", Endpoint = "https://api.hubapi.com", AuthType = "Bearer",
                 Description = "Integrate with HubSpot for marketing automation, CRM, and sales pipeline management." },
        new() { Name = "Zoho CRM", Category = "CRM", Endpoint = "https://www.zohoapis.com", AuthType = "OAuth2",
                 Description = "Connect to Zoho CRM for contact management, deal tracking, and sales analytics." },

        // Communication
        new() { Name = "Slack", Category = "Communication", Endpoint = "https://slack.com/api", AuthType = "Bearer",
                 Description = "Send messages, manage channels, and automate notifications via Slack." },
        new() { Name = "Microsoft Teams", Category = "Communication", Endpoint = "https://graph.microsoft.com", AuthType = "Bearer",
                 Description = "Integrate with Teams for messaging, meetings, and collaboration workflows." },
        new() { Name = "Twilio SMS", Category = "Communication", Endpoint = "https://api.twilio.com", AuthType = "Basic",
                 Description = "Send SMS, voice calls, and WhatsApp messages through Twilio." },
        new() { Name = "SendGrid Email", Category = "Communication", Endpoint = "https://api.sendgrid.com/v3", AuthType = "Bearer",
                 Description = "Send transactional and marketing emails via SendGrid." },

        // Storage
        new() { Name = "AWS S3", Category = "Storage", Endpoint = "https://s3.amazonaws.com", AuthType = "ApiKey",
                 Description = "Store, retrieve, and manage files in Amazon S3 buckets." },
        new() { Name = "Azure Blob", Category = "Storage", Endpoint = "https://{account}.blob.core.windows.net", AuthType = "ApiKey",
                 Description = "Connect to Azure Blob Storage for scalable cloud file storage." },
        new() { Name = "Google Drive", Category = "Storage", Endpoint = "https://www.googleapis.com/drive/v3", AuthType = "OAuth2",
                 Description = "Access and manage files in Google Drive, including shared drives." },

        // DevOps
        new() { Name = "GitHub", Category = "DevOps", Endpoint = "https://api.github.com", AuthType = "Bearer",
                 Description = "Manage repositories, issues, pull requests, and CI/CD via GitHub API." },
        new() { Name = "Jira", Category = "DevOps", Endpoint = "https://{domain}.atlassian.net", AuthType = "Basic",
                 Description = "Create and track issues, manage sprints, and automate project workflows." },
        new() { Name = "Azure DevOps", Category = "DevOps", Endpoint = "https://dev.azure.com", AuthType = "Bearer",
                 Description = "Integrate with Azure DevOps for pipelines, boards, and repo management." },

        // Finance
        new() { Name = "Stripe", Category = "Finance", Endpoint = "https://api.stripe.com/v1", AuthType = "Bearer",
                 Description = "Process payments, manage subscriptions, and handle invoicing with Stripe." },
        new() { Name = "QuickBooks", Category = "Finance", Endpoint = "https://quickbooks.api.intuit.com", AuthType = "OAuth2",
                 Description = "Sync invoices, expenses, and financial data with QuickBooks Online." },
        new() { Name = "SAP", Category = "Finance", Endpoint = "https://{host}/sap/opu/odata", AuthType = "Basic",
                 Description = "Connect to SAP ERP for enterprise finance, procurement, and logistics." },

        // HR
        new() { Name = "BambooHR", Category = "HR", Endpoint = "https://api.bamboohr.com/api/gateway.php", AuthType = "ApiKey",
                 Description = "Manage employee records, time-off requests, and HR reporting." },
        new() { Name = "Workday", Category = "HR", Endpoint = "https://{tenant}.workday.com/api", AuthType = "OAuth2",
                 Description = "Integrate with Workday for HR, payroll, and talent management." },

        // AI Automation
        new() { Name = "n8n", Category = "AI Automation", Endpoint = "https://{your-instance}.app.n8n.cloud/webhook", AuthType = "ApiKey",
                 Description = "Trigger and manage n8n workflow automations via webhooks and the n8n REST API." },
        new() { Name = "Dify", Category = "AI Automation", Endpoint = "https://api.dify.ai/v1", AuthType = "Bearer",
                 Description = "Connect to Dify AI app workflows and agents for LLM-powered automation." },
        new() { Name = "Langflow", Category = "AI Automation", Endpoint = "https://{your-instance}/api/v1", AuthType = "ApiKey",
                 Description = "Integrate with Langflow flows for visual LLM pipeline execution." },
        new() { Name = "Flowise", Category = "AI Automation", Endpoint = "https://{your-instance}/api/v1/prediction/{flow-id}", AuthType = "ApiKey",
                 Description = "Call Flowise chatflows and agent flows for low-code LLM orchestration." },
        new() { Name = "MCP Servers", Category = "AI Automation", Endpoint = "https://{your-mcp-server}/sse", AuthType = "Bearer",
                 Description = "Connect to Model Context Protocol (MCP) servers to expose external tools and resources." },
    };

    private List<ConnectorTemplate> FilteredConnectors
    {
        get
        {
            var list = _marketplaceConnectors.AsEnumerable();
            if (_categoryFilter != "All")
                list = list.Where(c => c.Category == _categoryFilter);
            if (!string.IsNullOrWhiteSpace(_searchTerm))
                list = list.Where(c => c.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
                                    || c.Category.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
                                    || c.Description.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
            return list.ToList();
        }
    }

    private IEnumerable<IntegrationDto> FilteredIntegrations =>
        string.IsNullOrWhiteSpace(_searchTerm)
            ? _integrations
            : _integrations.Where(i => i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
                                     || i.Type.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) await LoadIntegrations(); }

    private async Task LoadIntegrations()
    {
        _loading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<IntegrationsResult>("/api/v1/integrations");
            _integrations = result?.Items ?? new();

            // Mark already-installed marketplace connectors
            foreach (var integration in _integrations)
            {
                var match = _marketplaceConnectors.FirstOrDefault(c =>
                    c.Name.Equals(integration.Name, StringComparison.OrdinalIgnoreCase));
                if (match is not null)
                    _installedConnectors.Add(match.Name);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Failed to load: {ex.Message}", Severity.Error); }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task InstallConnector(ConnectorTemplate connector)
    {
        _installingConnector = connector.Name;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync("/api/v1/integrations", new
            {
                Name = connector.Name,
                Type = MapCategoryToToolType(connector.Category),
                Description = connector.Description,
                EndpointUrl = connector.Endpoint,
                Configuration = System.Text.Json.JsonSerializer.Serialize(new { AuthType = connector.AuthType }),
            });

            if (response.IsSuccessStatusCode)
            {
                _installedConnectors.Add(connector.Name);
                await LoadIntegrations();

                // Immediately open configure dialog so user can add credentials
                var installed = _integrations.FirstOrDefault(i =>
                    i.Name.Equals(connector.Name, StringComparison.OrdinalIgnoreCase));
                if (installed is not null)
                {
                    var parameters = new DialogParameters<CreateEditIntegrationDialog>
                    {
                        { x => x.EditId, installed.Id.ToString() },
                        { x => x.FromMarketplace, true }
                    };
                    var dialog = await Dialog.ShowAsync<CreateEditIntegrationDialog>(
                        $"Configure {connector.Name}", parameters);
                    var result = await dialog.Result;
                    if (result?.Canceled == false)
                        await LoadIntegrations();
                }
                else
                {
                    Snackbar.Add($"'{connector.Name}' installed — configure credentials to activate it.", Severity.Success);
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Install failed: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Install failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _installingConnector = null;
            StateHasChanged();
        }
    }

    private static string MapCategoryToToolType(string category) => category switch
    {
        "Communication" => "Email",
        "Storage" => "Custom",
        "DevOps" => "Http",
        "Finance" => "Http",
        "HR" => "Http",
        "CRM" => "Http",
        "AI Automation" => "Http",
        _ => "Http"
    };

    private static string GetIntegrationCategory(IntegrationDto integration)
    {
        var match = _marketplaceConnectors.FirstOrDefault(c =>
            c.Name.Equals(integration.Name, StringComparison.OrdinalIgnoreCase));
        return match?.Category ?? integration.Type;
    }

    private static string GetCategoryColor(string category) => category switch
    {
        "CRM" => "#7C3AED",
        "Communication" => "#3B82F6",
        "Storage" => "#10B981",
        "DevOps" => "#F97316",
        "Finance" => "#EAB308",
        "HR" => "#EC4899",
        "AI Automation" => "#14B8A6",
        _ => "#6B7280"
    };

    private static string GetCategoryIcon(string category) => category switch
    {
        "CRM" => Icons.Material.Filled.People,
        "Communication" => Icons.Material.Filled.Chat,
        "Storage" => Icons.Material.Filled.Cloud,
        "DevOps" => Icons.Material.Filled.Code,
        "Finance" => Icons.Material.Filled.AccountBalance,
        "HR" => Icons.Material.Filled.Badge,
        "AI Automation" => Icons.Material.Filled.Hub,
        _ => Icons.Material.Filled.Extension
    };

    private async Task OpenCreateDialog()
    {
        var dialog = await Dialog.ShowAsync<CreateEditIntegrationDialog>("New Integration");
        var result = await dialog.Result;
        if (result?.Canceled == false)
            await LoadIntegrations();
    }

    private async Task OpenEditDialog(IntegrationDto i)
    {
        var parameters = new DialogParameters<CreateEditIntegrationDialog>
        {
            { x => x.EditId, i.Id.ToString() }
        };
        var dialog = await Dialog.ShowAsync<CreateEditIntegrationDialog>("Edit Integration", parameters);
        var result = await dialog.Result;
        if (result?.Canceled == false)
            await LoadIntegrations();
    }

    private async Task TestIntegration(IntegrationDto integration)
    {
        _testingId = integration.Id;
        try
        {
            var response = await Http.PostAsJsonAsync($"/api/v1/integrations/{integration.Id}/test", new { });
            var result = await response.Content.ReadFromJsonAsync<TestResultDto>();
            var success = result?.Success ?? false;
            var message = result?.Message ?? "No response from integration.";
            _healthChecks[integration.Id] = (success, message, DateTime.Now);
            Snackbar.Add(message, success ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex)
        {
            _healthChecks[integration.Id] = (false, ex.Message, DateTime.Now);
            Snackbar.Add($"Test failed: {ex.Message}", Severity.Error);
        }
        finally { _testingId = null; }
    }

    private static string FormatRelativeTime(DateTime timestamp)
    {
        var diff = DateTime.Now - timestamp;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }

    private async Task ToggleIntegration(IntegrationDto integration)
    {
        try
        {
            await Http.PostAsJsonAsync($"/api/v1/integrations/{integration.Id}/toggle", new { });
            Snackbar.Add("Integration toggled", Severity.Success);
            await LoadIntegrations();
        }
        catch (Exception ex) { Snackbar.Add($"Toggle failed: {ex.Message}", Severity.Error); }
    }

    private async Task DeleteIntegration(IntegrationDto integration)
    {
        var parameters = new DialogParameters<DeleteConfirmationDialog>
        {
            { x => x.ItemName, integration.Name }
        };
        var dialog = await Dialog.ShowAsync<DeleteConfirmationDialog>("Confirm Delete", parameters);
        var result = await dialog.Result;
        if (result?.Canceled != false) return;

        try
        {
            await Http.DeleteAsync($"/api/v1/integrations/{integration.Id}");
            Snackbar.Add("Integration deleted", Severity.Success);
            await LoadIntegrations();
        }
        catch (Exception ex) { Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error); }
    }

    private static bool NeedsSetup(IntegrationDto i)
    {
        var hasPlaceholder = !string.IsNullOrEmpty(i.EndpointUrl) && i.EndpointUrl.Contains('{');
        var hasNoAuth = string.IsNullOrEmpty(i.Configuration)
            || i.Configuration.Contains("\"AuthType\":\"None\"")
            || i.Configuration == "{}"
            || !i.Configuration.Contains("AuthType");
        return hasPlaceholder || hasNoAuth;
    }

    // DTOs
    private class TestResultDto { public bool Success { get; set; } public string? Message { get; set; } }
    private class IntegrationsResult { public List<IntegrationDto> Items { get; set; } = new(); }
    private class IntegrationDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string Type { get; set; } = string.Empty;
        public string? EndpointUrl { get; set; }
        public string? Configuration { get; set; }
        public bool IsActive { get; set; }
        public DateTime CreatedAt { get; set; }
    }
    private class ConnectorTemplate
    {
        public string Name { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string Endpoint { get; set; } = string.Empty;
        public string AuthType { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}
