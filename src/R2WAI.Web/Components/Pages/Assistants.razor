    private async Task DeleteAssistant()
    {
        var parameters = new DialogParameters<DeleteConfirmationDialog>
        {
            { x => x.ItemName, _selectedAssistant!.Name },
            { x => x.Description, "This assistant and all its configuration will be permanently removed." }
        };
        var dialog = await Dialog.ShowAsync<DeleteConfirmationDialog>("Confirm Delete", parameters);
        var result = await dialog.Result;
        if (result?.Canceled != false) return;

        try
        {
            await Http.DeleteAsync($"/api/v1/assistants/{_selectedAssistant!.Id}");
            Snackbar.Add("Assistant deleted", Severity.Success);
            _selectedAssistant = null;
            await LoadData();
        }
        catch (Exception ex) { Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error); }
    }

    private async Task CloneAssistant()
    {
        try
        {
            var enabledTools = _availableTools.Where(t => t.IsEnabled).Select(t => t.ToolType).ToList();
            var response = await Http.PostAsJsonAsync("/api/v1/assistants", new
            {
                Name = $"{_editName} (Copy)",
                Description = _editDescription,
                Type = _editType,
                SystemPrompt = _editSystemPrompt,
                ModelConfigurationId = _editModelId,
                KnowledgeBaseId = _editKnowledgeBaseId,
                Tools = System.Text.Json.JsonSerializer.Serialize(enabledTools),
                Tags = _editTags,
            });
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Assistant cloned successfully", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add("Failed to clone assistant", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Clone failed: {ex.Message}", Severity.Error); }
    }

    private async Task ExportAssistant()
    {
        var config = new
        {
            Name = _editName,
            Type = _editType,
            Description = _editDescription,
            SystemPrompt = _editSystemPrompt,
            Tags = _editTags,
            Tools = _availableTools.Where(t => t.IsEnabled).Select(t => t.ToolType).ToList(),
            Tone = _editTone,
            ResponseLength = _editResponseLength,
            ResponseFormat = _editResponseFormat,
            WelcomeMessage = _editWelcomeMessage,
            ConversationStarters = _editStarters.Where(s => !string.IsNullOrWhiteSpace(s)).ToList(),
        };
        var json = System.Text.Json.JsonSerializer.Serialize(config, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        try
        {
            var bytes = System.Text.Encoding.UTF8.GetBytes(json);
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"{(_editName ?? "assistant").Replace(' ', '-').ToLowerInvariant()}-config.json";
            await JS.InvokeVoidAsync("eval",
                $"var a=document.createElement('a');a.href='data:application/json;base64,{base64}';a.download='{fileName}';document.body.appendChild(a);a.click();a.remove();");
            Snackbar.Add("Configuration exported", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
    }

