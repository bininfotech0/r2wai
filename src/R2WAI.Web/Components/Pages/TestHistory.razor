@page "/test-history"
@attribute [Authorize]
@inject AuthenticatedHttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>R2WAI - Test History</PageTitle>

<PageHeader Title="Test History" Subtitle="Every test run, with the real trace behind each result" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
}
else if (_runs.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Outlined.History" Title="No test runs yet"
                Description="Run a test case from the Test Cases page to see its history here." MinHeight="240px" />
}
else
{
    <MudTable Items="_runs" Hover="true" Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: 12px;">
        <HeaderContent>
            <MudTh>Started</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Passed</MudTh>
            <MudTh>Failed</MudTh>
            <MudTh>Warning</MudTh>
            <MudTh Style="text-align:right;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Started">@context.StartedAt.ToString("yyyy-MM-dd HH:mm")</MudTd>
            <MudTd DataLabel="Status"><StatusBadge Status="@context.Status" /></MudTd>
            <MudTd DataLabel="Passed"><MudText Color="Color.Success">@context.PassedCount</MudText></MudTd>
            <MudTd DataLabel="Failed"><MudText Color="Color.Error">@context.FailedCount</MudText></MudTd>
            <MudTd DataLabel="Warning"><MudText Color="Color.Warning">@context.WarningCount</MudText></MudTd>
            <MudTd Style="text-align:right;">
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => ViewDetail(context))">View</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<TestRunItem> _runs = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadRuns();

    private async Task LoadRuns()
    {
        _loading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<TestRunsResult>("/api/v1/testruns?page=1&pageSize=50");
            _runs = result?.Items ?? new();
        }
        catch (Exception ex) { Snackbar.Add($"Failed to load test history: {ex.Message}", Severity.Error); }
        finally { _loading = false; }
    }

    private async Task ViewDetail(TestRunItem run)
    {
        var parameters = new DialogParameters { ["RunId"] = run.Id };
        await Dialog.ShowAsync<TestRunDetailDialog>("Test Run Detail", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
    }

    private class TestRunsResult { public List<TestRunItem> Items { get; set; } = new(); }
    private class TestRunItem
    {
        public Guid Id { get; set; }
        public string Status { get; set; } = string.Empty;
        public DateTime StartedAt { get; set; }
        public int PassedCount { get; set; }
        public int FailedCount { get; set; }
        public int WarningCount { get; set; }
    }
}
