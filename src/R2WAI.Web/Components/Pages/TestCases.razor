@page "/test-cases"
@attribute [Authorize]
@inject AuthenticatedHttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>R2WAI - Test Cases</PageTitle>

<PageHeader Title="Test Cases" Subtitle="Define expected assistant behavior and verify it automatically">
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.PlaylistPlay" Disabled="@(_runningAll || _testCases.Count == 0)"
               OnClick="RunAllTests">
        @(_runningAll ? "Running..." : "Run All Tests")
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="btn-gradient"
               StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
        New Test Case
    </MudButton>
</PageHeader>

@if (_lastRunSummary is not null)
{
    <MudAlert Severity="@(_lastRunSummary.FailedCount > 0 ? Severity.Error : _lastRunSummary.WarningCount > 0 ? Severity.Warning : Severity.Success)"
              Class="mb-4" Dense="true" ContentAlignment="HorizontalAlignment.Left">
        <div class="d-flex align-center gap-4">
            <span>@_lastRunSummary.PassedCount Passed</span>
            <span>@_lastRunSummary.FailedCount Failed</span>
            <span>@_lastRunSummary.WarningCount Warning</span>
        </div>
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4" Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: var(--r2-radius-lg);">
    <div class="d-flex align-center gap-3 flex-wrap">
        <MudTextField T="string" Value="_searchTerm" ValueChanged="OnSearchChanged" Placeholder="Search test cases..."
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 240px; max-width: 320px; flex: 1;"
                      Immediate="true" DebounceInterval="300" />
        <MudSelect T="Guid?" Value="_assistantFilter" ValueChanged="OnAssistantFilterChanged"
                   Label="Assistant" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                   Style="min-width: 180px; max-width: 240px;">
            @foreach (var a in _assistants)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)a.Id)">@a.Name</MudSelectItem>
            }
        </MudSelect>
    </div>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
}
else if (_testCases.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Outlined.FactCheck" Title="No test cases yet"
                Description="Create a test case to verify an assistant answers correctly, calls the right capability, and never errors."
                ActionText="New Test Case" OnAction="OpenCreateDialog" MinHeight="240px" />
}
else
{
    <MudTable Items="_testCases" Hover="true" Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: var(--r2-radius-lg);">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Assistant</MudTh>
            <MudTh>Question</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="text-align:right;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Assistant">@GetAssistantName(context.AssistantId)</MudTd>
            <MudTd DataLabel="Question" Style="max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@context.Question</MudTd>
            <MudTd DataLabel="Status">
                <MudSwitch T="bool" Value="@context.IsEnabled" Color="Color.Primary"
                           ValueChanged="@(v => ToggleEnabled(context, v))"
                           aria-label="@($"Toggle {context.Name} enabled")" />
            </MudTd>
            <MudTd Style="text-align:right;">
                <MudTooltip Text="Run">
                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Primary"
                                   Disabled="@(_runningId == context.Id)" OnClick="@(() => RunOne(context))" aria-label="Run" />
                </MudTooltip>
                <MudTooltip Text="Duplicate">
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="@(() => Duplicate(context))" aria-label="Duplicate" />
                </MudTooltip>
                <MudTooltip Text="Edit">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditDialog(context))" aria-label="Edit" />
                </MudTooltip>
                <MudTooltip Text="Delete">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context))" aria-label="Delete" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<TestCaseItem> _testCases = new();
    private List<AssistantOption> _assistants = new();
    private bool _loading = true;
    private bool _runningAll;
    private Guid? _runningId;
    private string _searchTerm = string.Empty;
    private Guid? _assistantFilter;
    private RunSummary? _lastRunSummary;

    protected override async Task OnInitializedAsync()
    {
        await LoadAssistants();
        await LoadTestCases();
    }

    private async Task LoadAssistants()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<AssistantsResult>("/api/v1/assistants?page=1&pageSize=200");
            _assistants = (result?.Items ?? new()).Select(a => new AssistantOption { Id = a.Id, Name = a.Name }).ToList();
        }
        catch (Exception ex) { Snackbar.Add($"Failed to load assistants: {ex.Message}", Severity.Error); }
    }

    private async Task LoadTestCases()
    {
        _loading = true;
        try
        {
            var query = $"/api/v1/testcases?page=1&pageSize=200&search={Uri.EscapeDataString(_searchTerm)}";
            if (_assistantFilter.HasValue) query += $"&assistantId={_assistantFilter}";
            var result = await Http.GetFromJsonAsync<TestCasesResult>(query);
            _testCases = result?.Items ?? new();
        }
        catch (Exception ex) { Snackbar.Add($"Failed to load test cases: {ex.Message}", Severity.Error); }
        finally { _loading = false; }
    }

    private async Task OnSearchChanged(string value)
    {
        _searchTerm = value;
        await LoadTestCases();
    }

    private async Task OnAssistantFilterChanged(Guid? value)
    {
        _assistantFilter = value;
        await LoadTestCases();
    }

    private string GetAssistantName(Guid assistantId) =>
        _assistants.FirstOrDefault(a => a.Id == assistantId)?.Name ?? "—";

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters();
        var dialog = await Dialog.ShowAsync<CreateEditTestCaseDialog>("New Test Case", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result is { Canceled: false }) await LoadTestCases();
    }

    private async Task OpenEditDialog(TestCaseItem testCase)
    {
        var parameters = new DialogParameters { ["EditId"] = testCase.Id };
        var dialog = await Dialog.ShowAsync<CreateEditTestCaseDialog>("Edit Test Case", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result is { Canceled: false }) await LoadTestCases();
    }

    private async Task Duplicate(TestCaseItem testCase)
    {
        try
        {
            var payload = new
            {
                AssistantId = testCase.AssistantId,
                ApplicationId = testCase.ApplicationId,
                Name = $"{testCase.Name} (Copy)",
                Question = testCase.Question,
                ExpectedResponseContains = testCase.ExpectedResponseContains,
                ExpectedCapabilityCalled = testCase.ExpectedCapabilityCalled
            };
            var response = await Http.PostAsJsonAsync("/api/v1/testcases", payload);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Failed to duplicate test case", Severity.Error);
                return;
            }
            await LoadTestCases();
            Snackbar.Add("Test case duplicated", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Failed to duplicate: {ex.Message}", Severity.Error); }
    }

    private async Task ToggleEnabled(TestCaseItem testCase, bool isEnabled)
    {
        try
        {
            await Http.PostAsJsonAsync($"/api/v1/testcases/{testCase.Id}/status", new { IsEnabled = isEnabled });
            await LoadTestCases();
        }
        catch (Exception ex) { Snackbar.Add($"Failed to update test case: {ex.Message}", Severity.Error); }
    }

    private async Task Delete(TestCaseItem testCase)
    {
        var parameters = new DialogParameters<DeleteConfirmationDialog> { { x => x.ItemName, testCase.Name } };
        var dialog = await Dialog.ShowAsync<DeleteConfirmationDialog>("Confirm Delete", parameters);
        var result = await dialog.Result;
        if (result?.Canceled != false) return;

        try
        {
            await Http.DeleteAsync($"/api/v1/testcases/{testCase.Id}");
            await LoadTestCases();
            Snackbar.Add("Test case deleted", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Failed to delete: {ex.Message}", Severity.Error); }
    }

    private async Task RunOne(TestCaseItem testCase)
    {
        _runningId = testCase.Id;
        try
        {
            var response = await Http.PostAsync($"/api/v1/testcases/{testCase.Id}/run", null);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Failed to run test case", Severity.Error);
                return;
            }
            var run = await response.Content.ReadFromJsonAsync<TestRunResult>();
            if (run is not null)
            {
                _lastRunSummary = new RunSummary(run.PassedCount, run.FailedCount, run.WarningCount);
                var result = run.Results.FirstOrDefault();
                var severity = result?.Status == "Failed" ? Severity.Error : result?.Status == "Warning" ? Severity.Warning : Severity.Success;
                Snackbar.Add($"{testCase.Name}: {result?.Status ?? "Completed"}", severity);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Run failed: {ex.Message}", Severity.Error); }
        finally { _runningId = null; }
    }

    private async Task RunAllTests()
    {
        _runningAll = true;
        _lastRunSummary = null;
        try
        {
            var payload = new { AssistantId = _assistantFilter, ApplicationId = (Guid?)null };
            var response = await Http.PostAsJsonAsync("/api/v1/testcases/run-all", payload);
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Failed to run tests", Severity.Error);
                return;
            }
            var run = await response.Content.ReadFromJsonAsync<TestRunResult>();
            if (run is not null)
                _lastRunSummary = new RunSummary(run.PassedCount, run.FailedCount, run.WarningCount);
        }
        catch (Exception ex) { Snackbar.Add($"Run failed: {ex.Message}", Severity.Error); }
        finally { _runningAll = false; }
    }

    private record RunSummary(int PassedCount, int FailedCount, int WarningCount);

    private class AssistantOption { public Guid Id { get; set; } public string Name { get; set; } = string.Empty; }
    private class AssistantsResult { public List<AssistantListItem> Items { get; set; } = new(); }
    private class AssistantListItem { public Guid Id { get; set; } public string Name { get; set; } = string.Empty; }

    private class TestCasesResult { public List<TestCaseItem> Items { get; set; } = new(); }
    private class TestCaseItem
    {
        public Guid Id { get; set; }
        public Guid AssistantId { get; set; }
        public Guid? ApplicationId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Question { get; set; } = string.Empty;
        public string? ExpectedResponseContains { get; set; }
        public string? ExpectedCapabilityCalled { get; set; }
        public bool IsEnabled { get; set; }
    }

    private class TestRunResult
    {
        public int PassedCount { get; set; }
        public int FailedCount { get; set; }
        public int WarningCount { get; set; }
        public List<TestCaseResultItem> Results { get; set; } = new();
    }
    private class TestCaseResultItem { public string Status { get; set; } = string.Empty; }
}
