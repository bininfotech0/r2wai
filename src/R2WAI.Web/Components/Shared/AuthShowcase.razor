<div class="login-showcase">
    <div class="d-flex align-center gap-3 mb-6">
        <Brand Size="40" WordmarkTypo="Typo.h5" TextColorOverride="white" />
        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.45); font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; margin-top: 2px;">
            AI Assistant Platform
        </MudText>
    </div>

    <div class="showcase-badge mb-2">Work smarter. Deliver better.</div>

    <MudText Typo="Typo.h5" Style="font-weight: 700; color: white; line-height: 1.25; letter-spacing: -0.02em;" Class="mb-3">
        From request to outcome — <span class="gradient-text-accent">automatically</span>
    </MudText>
    <MudText Typo="Typo.body1" Style="color: rgba(255,255,255,0.65); line-height: 1.6;" Class="mb-6">
        R2WAI helps government and enterprise teams build AI assistants, automate workflows, and deliver outcomes with security, governance, and control.
    </MudText>

    <div class="d-flex flex-column gap-4">
        @foreach (var feature in _features)
        {
            <div class="showcase-feature">
                <div class="showcase-feature-icon">
                    <MudIcon Icon="@feature.Icon" Style="color: white; font-size: 1.15rem;" />
                </div>
                <div>
                    <MudText Typo="Typo.subtitle1" Style="color: white; font-weight: 600;">@feature.Title</MudText>
                    <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.6);">@feature.Description</MudText>
                </div>
            </div>
        }
    </div>

    <div class="showcase-trust mt-6">
        <div class="showcase-trust-icon">
            <MudIcon Icon="@Icons.Material.Filled.Verified" Style="color: white; font-size: 1.1rem;" />
        </div>
        <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.75); font-weight: 500; line-height: 1.5;">
            Trusted by teams to build secure, scalable, and auditable AI solutions.
        </MudText>
    </div>
</div>

@code {
    private readonly List<ShowcaseFeature> _features = new()
    {
        new(Icons.Material.Outlined.SmartToy, "AI Assistants", "Create intelligent assistants powered by RAG and enterprise knowledge."),
        new(Icons.Material.Outlined.AccountTree, "Workflow Automation", "Design, approve, and automate processes across departments."),
        new(Icons.Material.Outlined.Lock, "Secure & Compliant", "Role-based access, tenant isolation, and audit-ready by design."),
        new(Icons.Material.Outlined.Insights, "Real-time Insights", "Monitor conversations, runs, and performance in real time."),
    };

    private record ShowcaseFeature(string Icon, string Title, string Description);
}
