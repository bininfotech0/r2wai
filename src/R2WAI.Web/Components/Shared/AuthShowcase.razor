<div class="login-showcase">
    <div class="d-flex align-center gap-3 mb-8">
        <div style="width: 40px; height: 40px; border-radius: 12px; background: linear-gradient(135deg, #7C3AED, #6D28D9); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(124, 58, 237, 0.3); flex-shrink: 0;">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Style="color: white; font-size: 1.25rem;" />
        </div>
        <MudText Typo="Typo.h5" Style="font-weight: 700; color: white;">R2WAI</MudText>
    </div>

    <MudText Typo="Typo.h3" Style="font-weight: 700; color: white; line-height: 1.25; letter-spacing: -0.02em;" Class="mb-3">
        From request to outcome — automatically
    </MudText>
    <MudText Typo="Typo.body1" Style="color: rgba(255,255,255,0.65); line-height: 1.6;" Class="mb-6">
        See how R2WAI takes a request from any channel all the way to a fully audited outcome.
    </MudText>

    <div class="showcase-steps">
        @foreach (var step in _steps)
        {
            <div class="showcase-step">
                <div class="showcase-step-number">@step.Number</div>
                <div>
                    <MudText Typo="Typo.subtitle1" Style="color: white; font-weight: 600;">@step.Title</MudText>
                    <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.6);">@step.Description</MudText>
                </div>
            </div>
        }
    </div>

    <div class="showcase-tagline">
        <MudIcon Icon="@Icons.Material.Filled.Verified" Style="color: #34D399; font-size: 1.15rem; flex-shrink: 0; margin-top: 2px;" />
        <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.55); line-height: 1.55;">
            R2WAI combines <strong style="color: rgba(255,255,255,0.85);">AI Assistants</strong>, <strong style="color: rgba(255,255,255,0.85);">Enterprise Knowledge</strong>, <strong style="color: rgba(255,255,255,0.85);">Workflow Automation</strong>, <strong style="color: rgba(255,255,255,0.85);">Human Approvals</strong>, <strong style="color: rgba(255,255,255,0.85);">Document Intelligence</strong>, and <strong style="color: rgba(255,255,255,0.85);">Enterprise Integrations</strong> into one secure platform.
        </MudText>
    </div>
</div>

@code {
    private readonly List<ShowcaseStep> _steps = new()
    {
        new("01", "Request", "Any channel — web, email, Teams, API"),
        new("02", "AI Assistant", "Understands intent, extracts data, validates rules"),
        new("03", "Knowledge", "Searches enterprise policies & documents"),
        new("04", "Workflow", "Routes through the correct automated process"),
        new("05", "Approval", "Right humans notified with full context"),
        new("06", "Execution", "Actions fire across connected enterprise systems"),
        new("07", "Outcome", "Delivered with full audit trail & analytics"),
    };

    private record ShowcaseStep(string Number, string Title, string Description);
}
