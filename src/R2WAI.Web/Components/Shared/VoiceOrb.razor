@inject IJSRuntime JS
@implements IAsyncDisposable

<canvas @ref="_canvas" class="voice-orb-canvas" style="@($"width:{Size}px;height:{Size}px;")"></canvas>

@code {
    public enum OrbState { Idle, Listening, Thinking, Speaking }

    [Parameter] public OrbState State { get; set; } = OrbState.Idle;
    [Parameter] public int Size { get; set; } = 40;

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private bool _initialized;
    private OrbState _appliedState = OrbState.Idle;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/orb3d.js");
                _initialized = await _module.InvokeAsync<bool>("init", _canvas);
                if (_initialized)
                    await ApplyState();
            }
            catch { }
        }
        else if (_initialized && _appliedState != State)
        {
            await ApplyState();
        }
    }

    private async Task ApplyState()
    {
        if (_module is null) return;
        _appliedState = State;
        try { await _module.InvokeVoidAsync("setState", _canvas, State.ToString().ToLowerInvariant()); }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _canvas); } catch { }
            await _module.DisposeAsync();
        }
    }
}
