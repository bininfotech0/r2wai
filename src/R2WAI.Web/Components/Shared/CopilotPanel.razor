@using R2WAI.Web.Services
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@inject AuthenticatedHttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject TokenStorageService TokenStorage
@implements IAsyncDisposable

@if (IsOpen)
{
<div class="copilot-panel copilot-panel-mobile" style="position: fixed; top: 0; right: 0; bottom: 0; width: min(360px, 100vw); z-index: 1300; background: var(--mud-palette-surface); border-left: 1px solid var(--mud-palette-divider); display: flex; flex-direction: column; box-shadow: -4px 0 16px rgba(0,0,0,0.1); animation: slideInRight 0.25s ease-out;">
    <div class="copilot-header pa-3 d-flex justify-space-between align-center"
         style="border-bottom: 1px solid var(--mud-palette-divider);">
        <div class="d-flex align-center gap-2">
            @if (_sttSupported || _ttsSupported)
            {
                <VoiceOrb State="OrbState" Size="26" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Color="Color.Primary" Size="Size.Small" />
            }
            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">R2WAI Copilot</MudText>
        </div>
        <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="Close" aria-label="Close copilot" />
    </div>

    <div class="copilot-context px-3 py-2" style="background: var(--mud-palette-background); border-bottom: 1px solid var(--mud-palette-divider);">
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            <MudIcon Icon="@Icons.Material.Outlined.LocationOn" Size="Size.Small" Style="font-size: 14px; vertical-align: middle;" />
            @GetCurrentPageName()
        </MudText>
    </div>

    <div class="sr-only" role="status" aria-live="polite" aria-atomic="true">@_liveAnnouncement</div>
    <div class="copilot-messages pa-3" style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 12px;">
        @if (_messages.Count == 0)
        {
            <div class="text-center pa-6">
                <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Large" Color="Color.Primary" Style="opacity: 0.3;" />
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3">
                    Ask me anything about R2WAI
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                    I can answer questions and point you to the right place — assistants, workflows, knowledge bases, and more.
                </MudText>
                <div class="d-flex flex-column gap-2 mt-4">
                    @foreach (var suggestion in GetContextSuggestions())
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default" FullWidth="true"
                                   OnClick="@(() => SendSuggestion(suggestion))"
                                   Style="border-radius: 8px; text-transform: none; justify-content: flex-start;">
                            "@suggestion"
                        </MudButton>
                    }
                </div>
            </div>
        }
        else
        {
            @foreach (var msg in _messages)
            {
                <div class="@($"copilot-message copilot-message--{(msg.IsUser ? "user" : msg.IsError ? "error" : "assistant")}")">
                    @if (!msg.IsUser)
                    {
                        <MudIcon Icon="@(msg.IsError ? Icons.Material.Outlined.ErrorOutline : Icons.Material.Outlined.AutoAwesome)"
                                 Size="Size.Small" Color="@(msg.IsError ? Color.Warning : Color.Primary)"
                                 Style="margin-right: 8px; margin-top: 2px;" />
                    }
                    <div style="flex: 1;">
                        @if (msg.IsUser)
                        {
                            <MudText Typo="Typo.body2">@msg.Content</MudText>
                        }
                        else if (msg.IsError)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Warning">@msg.Content</MudText>
                        }
                        else
                        {
                            <MarkdownRenderer Content="@msg.Content" Style="font-size: 0.875rem;" />
                        }
                        <div class="d-flex align-center gap-1 mt-1 flex-wrap">
                            @if (!msg.IsUser && !msg.IsError && _ttsSupported)
                            {
                                <MudIconButton Icon="@(_speakingMessageIndex == _messages.IndexOf(msg) ? Icons.Material.Filled.StopCircle : Icons.Material.Filled.VolumeUp)"
                                               Size="Size.Small" Color="@(_speakingMessageIndex == _messages.IndexOf(msg) ? Color.Primary : Color.Default)"
                                               OnClick="@(() => ToggleSpeakMessage(msg))"
                                               Style="width: 22px; height: 22px; opacity: 0.6;"
                                               aria-label="Read aloud" />
                            }
                            @if (msg.IsError && !string.IsNullOrEmpty(msg.RetryText))
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Refresh"
                                           OnClick="@(() => RetryMessage(msg.RetryText!))" Style="border-radius: 8px;">
                                    Try again
                                </MudButton>
                            }
                            @foreach (var action in msg.Actions)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => ExecuteAction(action))" Style="border-radius: 8px;">
                                    @action.Label
                                </MudButton>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (_isThinking && !_isStreaming)
            {
                <div class="copilot-message copilot-message--assistant">
                    <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Small" Color="Color.Primary"
                             Style="margin-right: 8px; margin-top: 2px;" />
                    <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true" />
                </div>
            }

            @if (_isStreaming)
            {
                <div class="d-flex justify-start">
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.StopCircle" OnClick="StopGenerating"
                               Style="border-radius: 8px; margin-left: 28px;">
                        Stop
                    </MudButton>
                </div>
            }
        }
    </div>

    @if (_isListening)
    {
        <div class="d-flex align-center gap-2 px-3 py-1" style="background: rgba(76, 175, 80, 0.08); border-top: 1px solid rgba(76, 175, 80, 0.2);">
            <div class="voice-pulse-dot"></div>
            <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: 600; font-size: 0.7rem;">
                @(_interimTranscript.Length > 0 ? _interimTranscript : "Listening...")
            </MudText>
        </div>
    }

    <div class="copilot-input pa-3" style="border-top: 1px solid var(--mud-palette-divider);">
        <div class="d-flex align-center gap-1">
            @if (_sttSupported)
            {
                <MudIconButton Icon="@(_isListening ? Icons.Material.Filled.MicOff : Icons.Material.Filled.Mic)"
                               Color="@(_isListening ? Color.Error : Color.Default)"
                               OnClick="ToggleVoiceInput" Size="Size.Small"
                               Disabled="@(_isThinking || _isStreaming)"
                               Style="@(_isListening ? "animation: pulse-soft 1.5s infinite;" : "")"
                               aria-label="@(_isListening ? "Stop voice input" : "Voice input")" />
            }
            <MudTextField @bind-Value="_input" Placeholder="@(_isListening ? "Speak now..." : "Ask R2WAI anything...")"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Disabled="@(_isThinking || _isStreaming)"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Send"
                          AdornmentColor="Color.Primary" OnAdornmentClick="SendMessage"
                          OnKeyUp="HandleKeyUp" Immediate="true"
                          Style="border-radius: 10px; flex: 1;" aria-label="Copilot input" />
        </div>
    </div>
</div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private const string ConversationStorageKey = "r2wai_copilot_conversation_id";

    private string _input = string.Empty;
    private bool _isThinking;
    private bool _isStreaming;
    private List<CopilotMessage> _messages = new();

    private Guid? _conversationId;
    private ChatSessionService? _chatSession;
    private CancellationTokenSource? _sendCts;
    private string _streamBuffer = string.Empty;
    private CopilotMessage? _activeStreamingMessage;
    private string _liveAnnouncement = string.Empty;
    private bool _hydrated;

    private VoiceSession? _voice;
    private bool _sttSupported;
    private bool _ttsSupported;
    private bool _isListening;
    private string _interimTranscript = string.Empty;
    private int _speakingMessageIndex = -1;
    private bool _voiceInitialized;

    private VoiceOrb.OrbState OrbState =>
        _isListening ? VoiceOrb.OrbState.Listening :
        (_isThinking || _isStreaming) ? VoiceOrb.OrbState.Thinking :
        _speakingMessageIndex >= 0 ? VoiceOrb.OrbState.Speaking :
        VoiceOrb.OrbState.Idle;

    private async Task InitVoice()
    {
        if (_voiceInitialized) return;
        try
        {
            _voice = new VoiceSession(JS);
            await _voice.InitAsync();
            _voice.TranscriptReceived += OnVoiceTranscript;
            _voice.StatusChanged += OnVoiceStatusChanged;
            _voice.SpeakDone += OnVoiceSpeakDone;
            _sttSupported = _voice.SttSupported;
            _ttsSupported = _voice.TtsSupported;
            _voiceInitialized = true;
            StateHasChanged();
        }
        catch { }
    }

    private bool _wasOpen;

    // MainLayout drives visibility via @bind-IsOpen, which sets the IsOpen parameter directly
    // rather than calling Open() — so the "just opened" side effects (voice init, hydrating the
    // saved conversation) have to be detected here, not only in Open()/Toggle() below.
    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            _ = InitVoice();
            _ = HydrateConversationAsync();
        }
        else if (!IsOpen)
        {
            _wasOpen = false;
        }
    }

    public void Open()
    {
        IsOpen = true;
        IsOpenChanged.InvokeAsync(true);
        StateHasChanged();
        _ = InitVoice();
        _ = HydrateConversationAsync();
    }

    public void Close()
    {
        IsOpen = false;
        IsOpenChanged.InvokeAsync(false);
        StateHasChanged();
    }

    public void Toggle()
    {
        if (IsOpen) Close(); else Open();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_input))
            await SendMessage();
    }

    private async Task SendSuggestion(string text)
    {
        _input = text;
        await SendMessage();
    }

    private async Task RetryMessage(string userMessage)
    {
        await SendUserText(userMessage);
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        var userMessage = _input.Trim();
        _input = string.Empty;
        await SendUserText(userMessage);
    }

    private async Task SendUserText(string userMessage)
    {
        _messages.Add(new CopilotMessage { Content = userMessage, IsUser = true });
        _isThinking = true;
        StateHasChanged();

        _sendCts = new CancellationTokenSource();
        var cancelToken = _sendCts.Token;
        CopilotMessage? streamingMsg = null;

        try
        {
            var conversationId = await EnsureConversationAsync();
            if (conversationId is null)
            {
                AddErrorMessage(userMessage, "R2WAI Copilot couldn't start a conversation. Please try again.");
                return;
            }

            await EnsureHubConnectionAsync();
            await JoinConversationGroupAsync(conversationId.Value);

            _isThinking = false;
            _isStreaming = true;
            _streamBuffer = string.Empty;
            streamingMsg = new CopilotMessage { Content = string.Empty, IsUser = false };
            _activeStreamingMessage = streamingMsg;
            _messages.Add(streamingMsg);
            StateHasChanged();

            var result = await _chatSession!.SendMessageAsync(conversationId.Value, userMessage, cancelToken);

            if (result.Success)
            {
                streamingMsg.Content = !string.IsNullOrEmpty(result.Content) ? result.Content : _streamBuffer;
                streamingMsg.Actions = GetContextualActions(userMessage);
                _liveAnnouncement = streamingMsg.Content.Length <= 160 ? streamingMsg.Content : streamingMsg.Content[..160] + "…";
            }
            else if (result.Cancelled)
            {
                if (cancelToken.IsCancellationRequested)
                {
                    // Actually cancelled via the Stop button.
                    streamingMsg.Content = string.IsNullOrEmpty(_streamBuffer)
                        ? "_Stopped before responding._"
                        : $"{_streamBuffer}\n\n_[Stopped by user]_";
                    _liveAnnouncement = "Response stopped.";
                }
                else
                {
                    // Timed out for some other reason (e.g. the assistant took too long) — this is a
                    // failure, not something the user asked for, so don't claim it was a user stop.
                    _messages.Remove(streamingMsg);
                    streamingMsg = null;
                    AddErrorMessage(userMessage, "R2WAI Copilot took too long to respond. Please try again.");
                }
            }
            else
            {
                _messages.Remove(streamingMsg);
                streamingMsg = null;
                AddErrorMessage(userMessage, $"R2WAI Copilot couldn't respond ({result.ErrorMessage}). Please try again.");
            }
        }
        catch (Exception)
        {
            if (streamingMsg is not null) _messages.Remove(streamingMsg);
            AddErrorMessage(userMessage, "R2WAI Copilot couldn't respond — check your connection and try again.");
        }
        finally
        {
            _isThinking = false;
            _isStreaming = false;
            _activeStreamingMessage = null;
            _sendCts?.Dispose();
            _sendCts = null;
            StateHasChanged();
        }
    }

    private void StopGenerating() => _sendCts?.Cancel();

    private void AddErrorMessage(string originalUserText, string errorText)
    {
        _messages.Add(new CopilotMessage
        {
            Content = errorText,
            IsUser = false,
            IsError = true,
            RetryText = originalUserText
        });
        _liveAnnouncement = errorText;
    }

    private async Task<Guid?> EnsureConversationAsync()
    {
        if (_conversationId.HasValue) return _conversationId;

        try
        {
            var response = await Http.PostAsJsonAsync("/api/v1/chat/conversations", new { Title = "Copilot", Module = "copilot" });
            if (!response.IsSuccessStatusCode) return null;

            var created = await response.Content.ReadFromJsonAsync<ConversationCreatedResult>();
            if (created is null) return null;

            _conversationId = created.Id;
            try { await JS.InvokeVoidAsync("localStorage.setItem", ConversationStorageKey, created.Id.ToString()); }
            catch { }

            return created.Id;
        }
        catch
        {
            return null;
        }
    }

    private async Task HydrateConversationAsync()
    {
        if (_hydrated) return;
        _hydrated = true;

        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ConversationStorageKey);
            if (string.IsNullOrEmpty(saved) || !Guid.TryParse(saved, out var id)) return;

            var result = await Http.GetFromJsonAsync<PagedMessagesResult>($"/api/v1/chat/conversations/{id}/messages?pageSize=100");
            if (result is null)
            {
                try { await JS.InvokeVoidAsync("localStorage.removeItem", ConversationStorageKey); }
                catch { }
                return;
            }

            _conversationId = id;
            _messages = result.Items.Select(m => new CopilotMessage
            {
                Content = m.Content,
                IsUser = m.Role.Equals("user", StringComparison.OrdinalIgnoreCase)
            }).ToList();

            await EnsureHubConnectionAsync();
            await JoinConversationGroupAsync(id);

            StateHasChanged();
        }
        catch { }
    }

    private async Task EnsureHubConnectionAsync()
    {
        if (_chatSession is null)
        {
            _chatSession = new ChatSessionService(Http, Configuration, Navigation, TokenStorage);
            _chatSession.OnChunk += chunk =>
            {
                _streamBuffer += chunk;
                if (_activeStreamingMessage is not null)
                    _activeStreamingMessage.Content = _streamBuffer;
                InvokeAsync(StateHasChanged);
            };
        }

        await _chatSession.ConnectAsync();
    }

    private async Task JoinConversationGroupAsync(Guid conversationId)
    {
        if (_chatSession is null) return;
        await _chatSession.JoinConversationAsync(conversationId);
    }

    private List<CopilotAction> GetContextualActions(string input)
    {
        var lower = input.ToLowerInvariant();
        if (lower.Contains("assistant") || lower.Contains("ai") || lower.Contains("create"))
            return new() { new() { Label = "Go to Assistants", Url = "/assistant-studio" } };
        if (lower.Contains("workflow") || lower.Contains("approval") || lower.Contains("flow"))
            return new() { new() { Label = "Go to Workflows", Url = "/workflow-studio" } };
        if (lower.Contains("knowledge") || lower.Contains("document") || lower.Contains("upload"))
            return new() { new() { Label = "Go to Knowledge", Url = "/assistant-studio/knowledge" } };
        if (lower.Contains("user") || lower.Contains("role") || lower.Contains("setting"))
            return new() { new() { Label = "Go to Admin", Url = "/admin/users" } };
        if (lower.Contains("operation") || lower.Contains("health") || lower.Contains("error"))
            return new() { new() { Label = "Go to Operations", Url = "/operations" } };
        return new() { new() { Label = "Go to Home", Url = "/" } };
    }

    private void ExecuteAction(CopilotAction action)
    {
        if (!string.IsNullOrEmpty(action.Url))
            Navigation.NavigateTo(action.Url);
    }

    private string GetCurrentPageName()
    {
        var uri = new Uri(Navigation.Uri);
        var path = uri.AbsolutePath.Trim('/');
        return path switch
        {
            "" => "Home",
            "assistant-studio" => "AI Assistant Studio",
            "workflow-studio" => "Workflow Studio",
            "operations" => "Operations Center",
            "settings" => "User Management",
            "admin/users" => "User Management",
            "inbox" => "Inbox",
            _ when path.StartsWith("assistant-studio") => "AI Studio",
            _ when path.StartsWith("workflow-studio") => "Workflow Studio",
            _ when path.StartsWith("operations") => "Operations",
            _ when path.StartsWith("admin") || path.StartsWith("settings") => "Administration",
            _ => path
        };
    }

    private List<string> GetContextSuggestions() => GetCurrentPageName() switch
    {
        "AI Assistant Studio" or "AI Studio" => new() { "Create an HR onboarding assistant", "How do I connect a knowledge base?" },
        "Workflow Studio" => new() { "What workflows failed today?", "Create an approval workflow" },
        "Operations Center" or "Operations" => new() { "Show me today's error rate", "Which workflows are stuck?" },
        "Inbox" => new() { "Summarize my pending approvals", "Which approvals are overdue?" },
        "Administration" or "User Management" => new() { "How do I add a new user?", "Show me the AI model configuration" },
        _ => new() { "Create an HR onboarding assistant", "Show me pending approvals", "What workflows failed today?" }
    };

    private class CopilotMessage
    {
        public string Content { get; set; } = string.Empty;
        public bool IsUser { get; set; }
        public bool IsError { get; set; }
        public string? RetryText { get; set; }
        public List<CopilotAction> Actions { get; set; } = new();
    }

    private class CopilotAction
    {
        public string Label { get; set; } = string.Empty;
        public string? Url { get; set; }
    }

    private async Task ToggleVoiceInput()
    {
        if (_voice is null) return;

        if (_isListening)
        {
            _isListening = false;
            _interimTranscript = string.Empty;
            await _voice.StopListening();
            StateHasChanged();
        }
        else
        {
            _interimTranscript = string.Empty;
            await _voice.StartListening();
        }
    }

    private void OnVoiceTranscript(string transcript, bool isFinal)
    {
        if (isFinal)
        {
            _input = transcript;
            _interimTranscript = string.Empty;
            _isListening = false;
        }
        else
        {
            _interimTranscript = transcript;
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnVoiceStatusChanged(string status)
    {
        _isListening = status == "listening";
        if (status == "not-allowed")
            Snackbar.Add("Microphone access denied.", Severity.Warning);
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleSpeakMessage(CopilotMessage msg)
    {
        if (_voice is null) return;
        var idx = _messages.IndexOf(msg);

        if (_speakingMessageIndex == idx)
        {
            await _voice.StopSpeaking();
            _speakingMessageIndex = -1;
            StateHasChanged();
            return;
        }

        _speakingMessageIndex = idx;
        StateHasChanged();
        await _voice.Speak(msg.Content);
    }

    private void OnVoiceSpeakDone()
    {
        _speakingMessageIndex = -1;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_voice is not null)
        {
            _voice.TranscriptReceived -= OnVoiceTranscript;
            _voice.StatusChanged -= OnVoiceStatusChanged;
            _voice.SpeakDone -= OnVoiceSpeakDone;
            await _voice.DisposeAsync();
        }

        _sendCts?.Cancel();
        _sendCts?.Dispose();

        if (_chatSession is not null)
        {
            try { await _chatSession.DisposeAsync(); }
            catch { }
        }
    }

    private class ConversationCreatedResult
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
    }

    private class PagedMessagesResult
    {
        public List<MessageItem> Items { get; set; } = new();
        public int TotalCount { get; set; }
    }

    private class MessageItem
    {
        public Guid Id { get; set; }
        public string Role { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
    }

}
