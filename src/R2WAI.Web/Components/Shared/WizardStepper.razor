<div class="d-flex align-center wizard-stepper" role="list" aria-label="Wizard progress">
    @for (var i = 0; i < Steps.Count; i++)
    {
        var index = i;
        var isComplete = index < CurrentStep;
        var isActive = index == CurrentStep;
        <div class="d-flex align-center" style="flex: @(index == Steps.Count - 1 ? "0 0 auto" : "1 1 auto");" role="listitem">
            <div class="d-flex flex-column align-center" style="min-width: 88px;">
                <div class="wizard-step-circle @(isComplete ? "wizard-step-circle--done" : isActive ? "wizard-step-circle--active" : "")"
                     aria-current="@(isActive ? "step" : null)">
                    @if (isComplete)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                    }
                    else
                    {
                        @(index + 1)
                    }
                </div>
                <MudText Typo="Typo.caption" Class="mt-1" Align="Align.Center"
                         Style="@($"font-weight: {(isActive ? "700" : "500")}; color: {(isActive ? "var(--mud-palette-primary)" : "var(--mud-palette-text-secondary)")};")">
                    @Steps[index]
                </MudText>
            </div>
            @if (index < Steps.Count - 1)
            {
                <div class="wizard-step-line @(isComplete ? "wizard-step-line--done" : "")"></div>
            }
        </div>
    }
</div>

<style>
    .wizard-step-circle {
        width: 32px; height: 32px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 0.8125rem;
        border: 2px solid var(--mud-palette-divider);
        color: var(--mud-palette-text-secondary);
        background: var(--mud-palette-surface);
        transition: all 0.15s ease;
    }
    .wizard-step-circle--active {
        border-color: var(--mud-palette-primary);
        color: var(--mud-palette-primary);
    }
    .wizard-step-circle--done {
        border-color: var(--mud-palette-primary);
        background: var(--mud-palette-primary);
        color: white;
    }
    .wizard-step-line {
        flex: 1 1 auto; height: 2px; background: var(--mud-palette-divider);
        margin: 0 8px 20px 8px; min-width: 24px;
    }
    .wizard-step-line--done { background: var(--mud-palette-primary); }
</style>

@code {
    [Parameter] public List<string> Steps { get; set; } = new();
    [Parameter] public int CurrentStep { get; set; }
}
