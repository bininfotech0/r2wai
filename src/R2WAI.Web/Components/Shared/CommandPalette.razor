@inject NavigationManager Navigation
@inject AuthenticatedHttpClient Http
@inject IJSRuntime JS
@implements IDisposable

<MudOverlay Visible="_visible" OnClick="Close" DarkBackground="true" ZIndex="9999" />

@if (_visible)
{
    <div style="position: fixed; top: 12%; left: 50%; transform: translateX(-50%); z-index: 10000; width: 90%; max-width: 600px;">
        <MudPaper Elevation="8" Class="pa-0" Style="border-radius: 14px; overflow: hidden;">
            <div class="d-flex align-center px-3 pt-3 gap-2">
                <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Color="Color.Primary" Size="Size.Small" />
                <MudTextField @ref="_searchField" @bind-Value="_query" Placeholder="Search or type a command..."
                              Variant="Variant.Filled" Margin="Margin.Dense" Class="flex-grow-1"
                              Immediate="true" DebounceInterval="200" AutoFocus="true"
                              OnKeyUp="HandleKeyUp" TextChanged="OnQueryChanged" aria-label="Command palette search" />
            </div>

            <MudList T="CommandItem" Dense="true" Class="pa-0" Style="max-height: 400px; overflow-y: auto;">
                @{ var currentCategory = ""; var items = FilteredItems; var index = -1; }
                @foreach (var item in items)
                {
                    index++;
                    var isSelected = _selectedIndex == index;
                    @if (item.Category != currentCategory)
                    {
                        currentCategory = item.Category;
                        <MudListSubheader>
                            <MudText Typo="Typo.caption" Style="font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;">
                                @currentCategory
                            </MudText>
                        </MudListSubheader>
                    }
                    <MudListItem T="CommandItem" id="@($"cmdpal-item-{index}")" OnClick="@(() => Execute(item))"
                                 Style="@(isSelected ? "background-color: var(--mud-palette-primary-lighten);" : "")">
                        <div class="d-flex align-center gap-3">
                            <MudIcon Icon="@item.Icon" Size="Size.Small" Color="@item.Color" />
                            <div style="flex: 1;">
                                <MudText Typo="Typo.body2">@item.Label</MudText>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Description</MudText>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(item.Shortcut))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">@item.Shortcut</MudText>
                            }
                        </div>
                    </MudListItem>
                }
                @if (FilteredItems.Count == 0 && !string.IsNullOrWhiteSpace(_query))
                {
                    <MudListItem T="CommandItem">
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="pa-4">
                            No results for "@_query"
                        </MudText>
                    </MudListItem>
                }
            </MudList>

            <MudDivider />
            <div class="d-flex justify-space-between align-center pa-2 px-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    <kbd>↑↓</kbd> navigate &nbsp; <kbd>Enter</kbd> select &nbsp; <kbd>Esc</kbd> close
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Tertiary">Ctrl+K</MudText>
            </div>
        </MudPaper>
    </div>
}

@code {
    private MudTextField<string>? _searchField;
    private bool _visible;
    private string _query = string.Empty;
    private int _selectedIndex;
    private List<CommandItem> _searchResults = new();
    private IJSObjectReference? _utilsModule;

    private static readonly List<CommandItem> QuickActions = new()
    {
        new("Add Application", "/applications/new", Icons.Material.Filled.Add, Color.Primary, "Quick Actions", "Connect a government application"),
        new("Create Assistant", "/assistant-studio", Icons.Material.Filled.Add, Color.Primary, "Quick Actions", "New AI assistant"),
        new("Create Workflow", "/workflow-studio", Icons.Material.Filled.Add, Color.Secondary, "Quick Actions", "New workflow"),
        new("Add Knowledge", "/assistant-studio/knowledge", Icons.Material.Filled.Add, Color.Tertiary, "Quick Actions", "New knowledge base"),
        new("Create Chatbot", "/chatbots", Icons.Material.Filled.Add, Color.Info, "Quick Actions", "New chatbot"),
        new("Upload Document", "/documents", Icons.Material.Filled.CloudUpload, Color.Tertiary, "Quick Actions", "Add to knowledge base"),
        new("Open Operations", "/operations", Icons.Material.Filled.MonitorHeart, Color.Tertiary, "Quick Actions", "Platform monitoring"),
        new("Open Governance", "/governance", Icons.Material.Filled.Shield, Color.Default, "Quick Actions", "Departments, models, policies"),
    };

    // Kept in sync with the sidebar groups in MainLayout.razor — category names match
    // the nav section headers (Build/Test/Publish/Monitor/Manage) exactly.
    private static readonly List<CommandItem> NavigationItems = new()
    {
        new("Home", "/", Icons.Material.Outlined.SpaceDashboard, Color.Default, "Home"),

        new("Applications", "/applications", Icons.Material.Outlined.Apps, Color.Primary, "Build"),
        new("Assistants", "/assistant-studio", Icons.Material.Outlined.SmartToy, Color.Primary, "Build"),
        new("Knowledge Bases", "/assistant-studio/knowledge", Icons.Material.Outlined.MenuBook, Color.Primary, "Build"),
        new("Documents", "/documents", Icons.Material.Outlined.Description, Color.Primary, "Build"),
        new("Tools & APIs", "/assistant-studio/tools", Icons.Material.Outlined.Build, Color.Primary, "Build"),
        new("Templates", "/templates", Icons.Material.Outlined.DashboardCustomize, Color.Primary, "Build"),
        new("Workflows", "/workflow-studio", Icons.Material.Outlined.AccountTree, Color.Primary, "Build"),
        new("Inbox", "/inbox", Icons.Material.Outlined.Inbox, Color.Primary, "Build"),
        new("Approvals", "/workflow-studio/approvals", Icons.Material.Outlined.TaskAlt, Color.Primary, "Build"),
        new("Schedules", "/workflow-studio/schedules", Icons.Material.Outlined.Schedule, Color.Primary, "Build"),
        new("Integrations", "/workflow-studio/integrations", Icons.Material.Outlined.Extension, Color.Primary, "Build"),

        new("Playground", "/assistant-studio/playground", Icons.Material.Outlined.Chat, Color.Secondary, "Test"),
        new("Test Cases", "/test-cases", Icons.Material.Outlined.FactCheck, Color.Secondary, "Test"),
        new("Test History", "/test-history", Icons.Material.Outlined.History, Color.Secondary, "Test"),

        new("Channels", "/chatbots", Icons.Material.Outlined.Forum, Color.Tertiary, "Publish"),

        new("Overview", "/operations", Icons.Material.Outlined.Dashboard, Color.Tertiary, "Monitor"),
        new("Conversations", "/conversations", Icons.Material.Outlined.ChatBubbleOutline, Color.Tertiary, "Monitor"),
        new("AI Ops", "/operations/ai", Icons.Material.Outlined.Psychology, Color.Tertiary, "Monitor"),
        new("Analytics", "/operations/analytics", Icons.Material.Outlined.BarChart, Color.Tertiary, "Monitor"),
        new("Reports", "/operations/reports", Icons.Material.Outlined.Assessment, Color.Tertiary, "Monitor"),
        new("Audit", "/operations/audit-logs", Icons.Material.Outlined.History, Color.Tertiary, "Monitor"),
        new("Errors", "/operations/errors", Icons.Material.Outlined.BugReport, Color.Tertiary, "Monitor"),

        new("Profile", "/profile", Icons.Material.Outlined.Person, Color.Default, "Manage"),
        new("Users", "/admin/users", Icons.Material.Outlined.PeopleAlt, Color.Default, "Manage"),
        new("Roles", "/admin/roles", Icons.Material.Outlined.Shield, Color.Default, "Manage"),
        new("Models", "/admin/models", Icons.Material.Outlined.ModelTraining, Color.Default, "Manage"),
        new("Security", "/admin/security", Icons.Material.Outlined.Lock, Color.Default, "Manage"),
        new("Settings", "/settings", Icons.Material.Outlined.Settings, Color.Default, "Manage"),
        new("Organization", "/settings/tenant", Icons.Material.Outlined.Domain, Color.Default, "Manage"),
        new("Departments", "/governance/departments", Icons.Material.Outlined.AccountBalance, Color.Default, "Manage"),
        new("Permissions", "/admin/permissions", Icons.Material.Outlined.VerifiedUser, Color.Default, "Manage"),
        new("Moderation", "/admin/content-moderation", Icons.Material.Outlined.Security, Color.Default, "Manage"),
        new("Webhooks", "/admin/webhooks", Icons.Material.Outlined.Webhook, Color.Default, "Manage"),
        new("API Keys", "/admin/api-keys", Icons.Material.Outlined.Key, Color.Default, "Manage"),
        new("Governance Overview", "/governance", Icons.Material.Outlined.Shield, Color.Default, "Manage"),
    };

    private List<CommandItem> FilteredItems
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_query))
                return QuickActions.Concat(NavigationItems).ToList();

            var matching = QuickActions.Concat(NavigationItems)
                .Where(i =>
                    i.Label.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
                    (i.Description?.Contains(_query, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    i.Category.Contains(_query, StringComparison.OrdinalIgnoreCase))
                .ToList();

            if (_searchResults.Count > 0)
                matching = matching.Concat(_searchResults).ToList();

            return matching;
        }
    }

    private async Task OnQueryChanged(string value)
    {
        _selectedIndex = 0;
        if (!string.IsNullOrWhiteSpace(value) && value.Length >= 2)
            await SearchEntities(value);
        else
            _searchResults.Clear();
    }

    private async Task SearchEntities(string term)
    {
        try
        {
            var results = new List<CommandItem>();
            var encoded = Uri.EscapeDataString(term);

            try
            {
                var assistants = await Http.GetFromJsonAsync<SearchResult>($"/api/v1/assistants?pageSize=5&search={encoded}");
                if (assistants?.Items is not null)
                {
                    results.AddRange(assistants.Items.Select(a => new CommandItem(
                        a.Name, "/assistant-studio", Icons.Material.Filled.SmartToy, Color.Primary, "Assistants", $"AI Assistant")));
                }
            }
            catch { }

            try
            {
                var workflows = await Http.GetFromJsonAsync<SearchResult>($"/api/v1/workflows?pageSize=5&search={encoded}");
                if (workflows?.Items is not null)
                {
                    results.AddRange(workflows.Items.Select(w => new CommandItem(
                        w.Name, $"/workflow-studio/designer/{w.Id}", Icons.Material.Filled.AccountTree, Color.Secondary, "Workflows", "Workflow")));
                }
            }
            catch { }

            _searchResults = results;
            StateHasChanged();
        }
        catch { }
    }

    public void Open()
    {
        _visible = true;
        _query = string.Empty;
        _selectedIndex = 0;
        _searchResults.Clear();
        StateHasChanged();
    }

    public void Close()
    {
        _visible = false;
        StateHasChanged();
    }

    public void Toggle()
    {
        if (_visible) Close(); else Open();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        var items = FilteredItems;
        switch (e.Key)
        {
            case "Escape":
                Close();
                return;
            case "ArrowDown":
                _selectedIndex = Math.Min(_selectedIndex + 1, items.Count - 1);
                await ScrollSelectedIntoView();
                break;
            case "ArrowUp":
                _selectedIndex = Math.Max(_selectedIndex - 1, 0);
                await ScrollSelectedIntoView();
                break;
            case "Enter":
                if (_selectedIndex >= 0 && _selectedIndex < items.Count)
                    Execute(items[_selectedIndex]);
                break;
        }
    }

    private async Task ScrollSelectedIntoView()
    {
        try
        {
            _utilsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/utils.js");
            await _utilsModule.InvokeVoidAsync("scrollToElement", $"cmdpal-item-{_selectedIndex}");
        }
        catch { }
    }

    private void Execute(CommandItem item)
    {
        Close();
        Navigation.NavigateTo(item.Href);
    }

    public void Dispose()
    {
        if (_utilsModule is IAsyncDisposable disposable)
            _ = disposable.DisposeAsync();
    }

    private record CommandItem(string Label, string Href, string Icon, Color Color, string Category, string? Description = null, string? Shortcut = null);
    private class SearchResult { public List<SearchItem> Items { get; set; } = new(); }
    private class SearchItem { public Guid Id { get; set; } public string Name { get; set; } = string.Empty; }
}
