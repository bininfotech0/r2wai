@* Multi-series line chart — SVG for the plot, HTML overlay for axis labels (Razor's <text>
   special tag can't carry attributes, so native SVG text elements aren't usable here) —
   lightweight, no JS dependencies *@

<div class="d-flex flex-wrap gap-4 mb-3">
    @foreach (var series in Series)
    {
        <div class="d-flex align-center gap-2">
            <span style="width: 10px; height: 10px; border-radius: 50%; background: @series.Color; display: inline-block;"></span>
            <MudText Typo="Typo.caption" Style="font-weight: 600;">@series.Label</MudText>
        </div>
    }
</div>

<div style="width: 100%; height: @(Height)px; position: relative;">
    @* Y-axis value labels *@
    @for (var i = 0; i < YAxisLabels.Count; i++)
    {
        var topPct = GridLineYs[i] / (double)ViewBoxHeight * 100;
        <span style="position: absolute; left: 0; top: @(topPct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; transform: translateY(-50%); font-size: 10px; color: var(--mud-palette-text-secondary);">@YAxisLabels[i]</span>
    }

    @* X-axis date labels *@
    @for (var i = 0; i < XAxisLabels.Count; i++)
    {
        var leftPct = XLabelX(i) / (double)ViewBoxWidth * 100;
        <span style="position: absolute; left: @(leftPct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))%; bottom: 0; transform: translateX(-50%); font-size: 10px; color: var(--mud-palette-text-secondary); white-space: nowrap;">@XAxisLabels[i]</span>
    }

    <svg viewBox="0 0 @ViewBoxWidth @ViewBoxHeight" preserveAspectRatio="none" style="width: 100%; height: 100%; overflow: visible;">
        @* Horizontal gridlines *@
        @foreach (var gy in GridLineYs)
        {
            <line x1="@PaddingLeft" y1="@gy" x2="@(ViewBoxWidth - PaddingRight)" y2="@gy"
                  stroke="var(--mud-palette-divider)" stroke-width="1" stroke-dasharray="4 4" />
        }

        @* Series lines + points *@
        @foreach (var series in Series)
        {
            var pts = BuildPoints(series.Data);
            @if (pts.Count > 1)
            {
                var linePoints = string.Join(" ", pts.Select(p => $"{p.X.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)},{p.Y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}"));
                <polyline points="@linePoints" fill="none" stroke="@series.Color" stroke-width="2.5"
                          stroke-linecap="round" stroke-linejoin="round" />
                @foreach (var p in pts)
                {
                    <circle cx="@p.X.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" cy="@p.Y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" r="3" fill="@series.Color">
                        <title>@series.Label: @p.Value.ToString("N0")</title>
                    </circle>
                }
            }
        }
    </svg>
</div>

@code {
    [Parameter] public List<ChartSeries> Series { get; set; } = new();
    [Parameter] public List<string> XAxisLabels { get; set; } = new();
    [Parameter] public int Height { get; set; } = 220;

    private const int ViewBoxWidth = 600;
    private const int ViewBoxHeight = 220;
    private const int PaddingLeft = 28;
    private const int PaddingRight = 8;
    private const int PaddingTop = 12;
    private const int PaddingBottom = 24;

    private double MaxValue => Math.Max(1, Series.SelectMany(s => s.Data).DefaultIfEmpty(0).Max());

    private List<double> GridLineYs
    {
        get
        {
            var plotHeight = ViewBoxHeight - PaddingTop - PaddingBottom;
            return Enumerable.Range(0, 4).Select(i => PaddingTop + plotHeight * i / 3.0).ToList();
        }
    }

    private List<string> YAxisLabels
    {
        get
        {
            var max = MaxValue;
            return Enumerable.Range(0, 4).Select(i => Math.Round(max - max * i / 3.0).ToString("N0")).ToList();
        }
    }

    private double XLabelX(int index) =>
        XAxisLabels.Count > 1 ? PaddingLeft + index * (ViewBoxWidth - PaddingLeft - PaddingRight) / (double)(XAxisLabels.Count - 1) : PaddingLeft;

    private List<Point> BuildPoints(List<double> data)
    {
        var points = new List<Point>();
        if (data.Count == 0) return points;

        var plotWidth = ViewBoxWidth - PaddingLeft - PaddingRight;
        var plotHeight = ViewBoxHeight - PaddingTop - PaddingBottom;
        var max = MaxValue;
        var stepX = data.Count > 1 ? plotWidth / (double)(data.Count - 1) : 0;

        for (var i = 0; i < data.Count; i++)
        {
            var x = PaddingLeft + i * stepX;
            var y = PaddingTop + plotHeight - (data[i] / max * plotHeight);
            points.Add(new Point(x, y, data[i]));
        }
        return points;
    }

    private readonly record struct Point(double X, double Y, double Value);

    public class ChartSeries
    {
        public string Label { get; set; } = string.Empty;
        public string Color { get; set; } = "#7C3AED";
        public List<double> Data { get; set; } = new();
    }
}
