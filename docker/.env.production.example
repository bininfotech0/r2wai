# R2WAI Production Environment Variables
# Copy this file to .env and fill in the values

# Database
DB_PASSWORD=CHANGE_ME_strong_password_here

# JWT Authentication (min 32 characters)
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64

# Encryption (32-byte base64 key: openssl rand -base64 32)
ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# First-run administrator (used ONLY when the database is empty; no demo accounts are created).
# Password must be at least 12 characters and must not be one of the demo passwords published in the
# repository. Remove BOOTSTRAP_ADMIN_PASSWORD from this file after the first successful start.
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_at_least_12_characters

# AI Provider — both an online (OpenAI) and offline (Ollama) path are fully supported and can run
# side by side: per-assistant model selection (Manage > AI Models) resolves each assistant's own
# provider/endpoint/key independently, so some assistants can use OpenAI while others use a local
# Ollama model in the same deployment. The vars below only set the platform-wide fallback used when
# an assistant has no explicit ModelConfiguration selected.
#
# Online (default):
OPENAI_API_KEY=sk-your-openai-api-key
#
# Offline — uncomment to make Ollama the platform-wide fallback (or just register an Ollama-backed
# ModelConfiguration in the AI Models page; either works independently of these vars):
# AI_PROVIDER=ollama
# OLLAMA_ENDPOINT=http://your-ollama-host:11434
# OLLAMA_MODEL=llama3
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
#
# IMPORTANT: CPU-only Ollama is not viable for tool-enabled chat under real production load (observed
# 90s-200s+ per response in this project's own dev environment). A production Ollama deployment needs
# a real GPU-backed host — this compose file deliberately does not bundle an Ollama container the way
# the local dev docker-compose.yml does, since sharing this box's resources with the API would make
# the problem worse, not better.

# Email (optional — approval notifications won't send without this)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@yourcompany.com

# Entra ID (optional — for SSO)
# ENTRA_TENANT_ID=your-azure-tenant-id
# ENTRA_CLIENT_ID=your-azure-client-id
# ENTRA_CLIENT_SECRET=your-azure-client-secret

# Distributed tracing (optional). Unset = traces/metrics/logs export to the
# console only. To see real traces: docker compose -f docker-compose.production.yml
# -f docker-compose.monitoring.yml up -d, then set this and restart r2wai-api.
# OTLP_ENDPOINT=http://jaeger:4317
