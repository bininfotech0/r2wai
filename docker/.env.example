# Copy this file to docker/.env before running:
#   docker compose -f docker/docker-compose.yml up -d
#
# The app will not start without JWT_SECRET/DB_PASSWORD/ENCRYPTION_KEY set to
# real values -- Program.cs refuses to boot in production mode with the
# placeholder "CHANGE_ME" values or unexpanded "${...}" left in config.
#
# NOTE: if you change DB_PASSWORD after the postgres volume already exists,
# the database keeps the OLD password and the API will fail with Postgres
# "password authentication failed" errors. Either keep the password stable,
# or reset the volume: docker compose -f docker/docker-compose.yml down -v

# Required
DB_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=

# AI provider - defaults to a local Ollama instance on the host if unset.
# Set AI_PROVIDER=openai and OPENAI_API_KEY to use OpenAI instead.
AI_PROVIDER=ollama
OLLAMA_ENDPOINT=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBEDDING_MODEL=qwen2.5-coder:7b
# OPENAI_API_KEY=

# Storage for uploaded documents (Local or S3-compatible; MinIO/Redis are not
# part of this docker-compose stack -- see docker-compose.yml)
STORAGE_PROVIDER=Local

# Seeds one API key usable for machine-to-machine calls (Authorization: ApiKey ...)
API_KEY_0=
